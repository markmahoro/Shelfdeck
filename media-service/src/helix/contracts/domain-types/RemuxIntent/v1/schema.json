{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/RemuxIntent/v1",
  "title": "RemuxIntent@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "bounded-contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "intentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "schemaRef": {
      "const": "RemuxIntent@1"
    },
    "libraRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sourceHandleDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "mediaRequirementDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "outputContainer": {
      "const": "matroska"
    },
    "outputExtension": {
      "const": "mkv"
    },
    "streamPolicy": {
      "const": "copy_all_supported"
    },
    "intentDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "intentId",
    "revision",
    "schemaRef",
    "libraRunId",
    "sourceHandleDigest",
    "mediaRequirementDigest",
    "outputContainer",
    "outputExtension",
    "streamPolicy",
    "intentDigest"
  ],
  "x-helix-maxCanonicalBytes": 16384
}
