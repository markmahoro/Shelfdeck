{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/ArtifactRequirement/v1",
  "title": "ArtifactRequirement@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "bounded-contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requirementId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "schemaRef": {
      "type": "string",
      "minLength": 1
    },
    "artifactKind": {
      "type": "string",
      "minLength": 1
    },
    "requirementPayload": {
      "type": "object",
      "additionalProperties": true,
      "properties": {},
      "required": []
    },
    "requirementDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "requirementId",
    "revision",
    "schemaRef",
    "artifactKind",
    "requirementPayload",
    "requirementDigest"
  ],
  "x-helix-maxCanonicalBytes": 16384
}
