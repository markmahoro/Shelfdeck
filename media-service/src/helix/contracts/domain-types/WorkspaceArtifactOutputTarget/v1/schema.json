{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/WorkspaceArtifactOutputTarget/v1",
  "title": "WorkspaceArtifactOutputTarget@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "accepted-business-dto",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "targetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "libraRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "executionBasisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "expectedWorkspaceRevision": {
      "type": "integer",
      "minimum": 1
    },
    "expectedWorkspaceStateDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "rootSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspaceRootId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "rootRevision": {
          "type": "integer",
          "minimum": 1
        },
        "endpointId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "mountScopeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "rootLocation": {
          "type": "string",
          "minLength": 1
        },
        "containmentDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "capacitySnapshotDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshotDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "workspaceRootId",
        "rootRevision",
        "endpointId",
        "mountScopeId",
        "rootLocation",
        "containmentDigest",
        "capacitySnapshotDigest",
        "snapshotDigest"
      ]
    },
    "workspaceScopeDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "targetRelativePath": {
      "type": "string",
      "minLength": 1
    },
    "outputKind": {
      "type": "string",
      "enum": [
        "frame_set",
        "western_analysis"
      ]
    },
    "sourceInputDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "effectScopeDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "targetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "targetId",
    "libraRunId",
    "executionBasisDigest",
    "workspaceId",
    "expectedWorkspaceRevision",
    "expectedWorkspaceStateDigest",
    "rootSnapshot",
    "workspaceScopeDigest",
    "targetRelativePath",
    "outputKind",
    "sourceInputDigest",
    "effectScopeDigest",
    "targetDigest"
  ],
  "x-helix-maxCanonicalBytes": 16384
}
