{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/ResolvedProviderIdentity/v1",
  "title": "ResolvedProviderIdentity@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "accepted-business-dto",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "tmdb",
        "jav",
        "internal"
      ]
    },
    "namespace": {
      "type": "string",
      "enum": [
        "tmdb_movie",
        "tmdb_series",
        "jav_code",
        "internal_identity"
      ]
    },
    "providerKey": {
      "type": "string",
      "minLength": 1
    },
    "seasonNumber": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "identityAnchorDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "provider",
    "namespace",
    "providerKey",
    "seasonNumber",
    "identityAnchorDigest"
  ]
}
