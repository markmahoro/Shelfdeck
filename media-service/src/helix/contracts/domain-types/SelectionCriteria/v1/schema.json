{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/SelectionCriteria/v1",
  "title": "SelectionCriteria@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "bounded-contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "schemaRef": {
      "const": "SelectionCriteria@1"
    },
    "queryDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "strategy": {
      "const": "available_provider_rank_then_candidate_id"
    },
    "criteriaDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "contractId",
    "revision",
    "schemaRef",
    "queryDigest",
    "strategy",
    "criteriaDigest"
  ],
  "x-helix-maxCanonicalBytes": 16384
}
