  "required": [
    "schemaRef",
    "schemaVersion",
    "objectId",
    "revision",
    "scopeId",
    "shelfId",
    "endpointId",
    "mountScopeId",
    "shelfRoot",
    "rootLocation",
    "expectedVersion",
    "basis",
    "existingMembers",
    "missingKinds",
    "digest"
  ]
