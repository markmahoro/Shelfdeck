    "scopeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shelfId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "endpointId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
