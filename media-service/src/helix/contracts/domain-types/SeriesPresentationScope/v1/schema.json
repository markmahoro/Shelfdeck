            },
            "namespace": {
              "const": "tmdb_series"
            },
            "providerKey": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "seasonIdentityAnchorDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "integrationId": {
              "type": "string",
              "maxLength": 256,
