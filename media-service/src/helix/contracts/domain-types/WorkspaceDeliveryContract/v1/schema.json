{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/WorkspaceDeliveryContract/v1",
  "title": "WorkspaceDeliveryContract@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "bounded-contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "schemaRef": {
      "const": "WorkspaceDeliveryContract@1"
    },
    "libraRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "expectedWorkspaceRevision": {
      "type": "integer",
      "minimum": 1
    },
    "expectedWorkspaceStateDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "rootSnapshot": {
      "$ref": "helix://contracts/application-types/PlatformWorkspaceRootSnapshot/v1"
    },
    "stableExternalMaterialHandleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "verifiedPackageDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "memberSelector": {
      "const": "external_member_id"
    },
    "externalMemberId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "targetRelativePath": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "contractId",
    "revision",
    "schemaRef",
    "libraRunId",
    "workspaceId",
    "expectedWorkspaceRevision",
    "expectedWorkspaceStateDigest",
    "rootSnapshot",
    "stableExternalMaterialHandleId",
    "verifiedPackageDigest",
    "memberSelector",
    "externalMemberId",
    "targetRelativePath",
    "digest"
  ],
  "x-helix-maxCanonicalBytes": 32768
}
