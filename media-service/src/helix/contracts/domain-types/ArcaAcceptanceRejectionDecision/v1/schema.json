{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/ArcaAcceptanceRejectionDecision/v1",
  "title": "ArcaAcceptanceRejectionDecision@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "accepted-business-dto",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "acceptanceDecisionId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "acceptanceAttemptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "offerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "onDeckPackageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "packageDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "shelfId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "standardRevision": {
      "type": "integer",
      "minimum": 1
    },
    "placementRevision": {
      "type": "integer",
      "minimum": 1
    },
    "acceptanceCheckSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "actualGapUnionCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "identity_unmet",
          "season_identity_unmet",
          "structure_unmet",
          "episode_coverage_unmet",
          "metadata_field_unmet",
          "metadata_artifact_unmet",
          "sidecar_unrenderable",
          "image_undecodable",
          "media_form_unmet",
          "video_codec_unmet",
          "container_unmet",
          "file_extension_unmet",
          "minimum_raster_unmet",
          "system_upscale_forbidden",
          "primary_audio_unmet",
          "dynamic_range_conversion_unmet",
          "output_color_profile_unmet",
          "dolby_vision_metadata_not_removed",
          "playback_decode_failed",
          "max_size_exceeded"
        ]
      },
      "maxItems": 20,
      "uniqueItems": true
    },
    "actualGapUnionDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "authorizedDefectManifestDigestOrNull": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "authorizedGapComparison": {
      "type": "string",
      "enum": [
        "exact_match",
        "mismatch",
        "not_applicable"
      ]
    },
    "structuredRejection": {
      "$ref": "helix://contracts/domain-types/StructuredRejection/v1"
    },
    "decisionDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "decidedAtMs": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "acceptanceDecisionId",
    "acceptanceAttemptId",
    "offerId",
    "onDeckPackageId",
    "packageDigest",
    "shelfId",
    "standardRevision",
    "placementRevision",
    "acceptanceCheckSetDigest",
    "actualGapUnionCodes",
    "actualGapUnionDigest",
    "authorizedDefectManifestDigestOrNull",
    "authorizedGapComparison",
    "structuredRejection",
    "decisionDigest",
    "decidedAtMs"
  ],
  "x-helix-maxCanonicalBytes": 32768
}
