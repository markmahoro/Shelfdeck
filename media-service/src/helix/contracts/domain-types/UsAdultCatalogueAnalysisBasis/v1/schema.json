      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "shared.buffalo-representative-policy@1"
        },
        "contextMarginRatio": {
          "const": 0.25
        },
        "minimumFaceSize": {
          "const": 40
        },
        "maximumOtherFaceCentres": {
          "const": 0
        },
        "encoding": {
          "const": "png"
        },
        "maximumOutputBytes": {
          "const": 10485760
        },
        "policyDigest": {
          "const": "22c721f558c4e69b882e159e6e4654913bf1262144dbeea12f432c13566c7705"
        }
      },
