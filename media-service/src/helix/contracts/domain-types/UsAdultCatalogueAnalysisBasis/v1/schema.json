      "required": [
        "cpuSlots",
        "memoryBytes",
        "maximumFrames",
        "maximumFacesPerFrame",
        "maximumFrameBytes",
        "maximumWorkspaceBytes",
        "frameDeadlineMs",
        "imageDeadlineMs",
        "analysisDeadlineMs"
      ]
    },
    "basisDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "analysisId",
    "contentProfile",
    "libraRunId",
    "subjectId",
    "expectedRunStateRevision",
    "runExecutionBasisDigest",
    "resolvedIdentityDigest",
    "workspaceId",
    "sourceHandle",
    "sourceProbeRef",
    "durationMs",
    "faceModelRef",
    "catalogueGeneration",
    "catalogueSearchPolicy",
    "samplingPlan",
    "clusterParameters",
    "representativeImagePolicy",
    "selectionPolicy",
    "resourceBudget",
    "basisDigest"
