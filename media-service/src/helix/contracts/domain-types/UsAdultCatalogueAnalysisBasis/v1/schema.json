        "schema",
        "contextMarginRatio",
        "minimumFaceSize",
        "maximumOtherFaceCentres",
        "encoding",
        "maximumOutputBytes",
        "policyDigest"
      ]
    },
    "selectionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "libra.us-adult-catalogue-assessment-policy@1"
        },
        "maximumDistance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "minimumDistanceMargin": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "minimumRepresentativeStrata": {
          "type": "integer",
          "minimum": 2,
          "maximum": 3
        },
        "minimumCoverageStrata": {
          "type": "integer",
          "minimum": 3,
          "maximum": 20
        },
        "policyDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema",
        "maximumDistance",
        "minimumDistanceMargin",
        "minimumRepresentativeStrata",
        "minimumCoverageStrata",
        "policyDigest"
      ]
    },
    "resourceBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpuSlots": {
          "const": 1
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 536870912,
          "maximum": 8589934592
        },
        "maximumFrames": {
          "const": 40
        },
        "maximumFacesPerFrame": {
          "const": 32
        },
        "maximumFrameBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "maximumWorkspaceBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        "frameDeadlineMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "imageDeadlineMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "analysisDeadlineMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        }
