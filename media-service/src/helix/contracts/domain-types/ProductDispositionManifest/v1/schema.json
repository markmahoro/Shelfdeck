{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/ProductDispositionManifest/v1",
  "title": "ProductDispositionManifest@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "accepted-business-dto",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/domain-types/ProductDispositionManifest/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "objectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "onDeckRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "productManifestDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "relatedDispositionSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "sourceMaterialKey": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceRelatedReferenceId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "finalMaterialKey": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "finalRole": {
            "type": "string",
            "enum": [
              "primary_payload",
              "structural_dependency",
              "related",
              "artifact"
            ]
          },
          "dispositionKind": {
            "type": "string",
            "enum": [
              "direct_carried",
              "carried_forward",
              "replaced_and_settled"
            ]
          },
          "sourceToFinalMappingDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "memberDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "ordinal",
          "sourceMaterialKey",
          "sourceRelatedReferenceId",
          "finalMaterialKey",
          "finalRole",
          "dispositionKind",
          "sourceToFinalMappingDigest",
          "memberDigest"
        ]
      },
      "maxItems": 4096,
      "minItems": 1
    },
    "memberSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifestDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "objectId",
    "revision",
    "digest",
    "manifestId",
    "onDeckRunId",
    "productManifestDigest",
    "relatedDispositionSetDigest",
    "members",
    "memberSetDigest",
    "manifestDigest"
  ],
  "x-helix-maxCanonicalBytes": 8388608
}
