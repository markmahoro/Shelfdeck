{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/UsAdultMatchCompletion/v1",
  "title": "UsAdultMatchCompletion@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "accepted-business-dto",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/domain-types/UsAdultMatchCompletion/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "analysisId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "libraRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "subjectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "analysisBasisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "completedPageCount": {
      "type": "integer",
      "minimum": 1
    },
    "detectedFaceCount": {
      "type": "integer",
      "minimum": 0
    },
    "matchResultSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "winner": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pageOrdinal": {
              "type": "integer",
              "minimum": 0
            },
            "personSnapshot": {
              "$ref": "helix://contracts/domain-types/UsAdultPersonSnapshot/v1"
            },
            "matchResultRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "workId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "attemptId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "planId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "eventId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "resultId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "capabilityRef": {
                  "const": "shared.face.reference.match@1"
                },
                "resultSchemaRef": {
                  "const": "helix://contracts/capabilities/shared.face.reference.match/v1/result"
                },
                "resultDigest": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-f0-9]{64}$"
                },
                "inputBindingDigest": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "workId",
                "attemptId",
                "planId",
                "eventId",
                "resultId",
                "capabilityRef",
                "resultSchemaRef",
                "resultDigest",
                "inputBindingDigest"
              ]
            },
            "personMatchEvidence": {
              "$ref": "helix://contracts/types/PersonMatchEvidence/v1"
            }
          },
          "required": [
            "pageOrdinal",
            "personSnapshot",
            "matchResultRef",
            "personMatchEvidence"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "completionDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "analysisId",
    "libraRunId",
    "subjectId",
    "analysisBasisDigest",
    "completedPageCount",
    "detectedFaceCount",
    "matchResultSetDigest",
    "winner",
    "completionDigest"
  ],
  "x-helix-maxCanonicalBytes": 262144
}
