{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/VerifiedArtifactManifest/v1",
  "title": "VerifiedArtifactManifest@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "accepted-business-dto",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "manifestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "libraRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "artifactHandleId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "artifactKind": {
            "type": "string",
            "minLength": 1
          },
          "artifactRevision": {
            "type": "integer",
            "minimum": 1
          },
          "artifactDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "requirementId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "requirementRevision": {
            "type": "integer",
            "minimum": 1
          },
          "requirementSchemaRef": {
            "type": "string",
            "minLength": 1
          },
          "requirementDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "verificationEvidenceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "verificationEvidenceDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "verificationResultRef": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "workId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "attemptId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "planId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "eventId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "resultId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "capabilityRef": {
                "const": "shared.artifact.manifest.verify@1"
              },
              "resultSchemaRef": {
                "const": "helix://contracts/types/ArtifactManifestVerification/v1"
              },
              "resultDigest": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              },
              "inputBindingDigest": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "workId",
              "attemptId",
              "planId",
              "eventId",
              "resultId",
              "capabilityRef",
              "resultSchemaRef",
              "resultDigest",
              "inputBindingDigest"
            ]
          },
          "referenceDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "ordinal",
          "artifactHandleId",
          "artifactKind",
          "artifactRevision",
          "artifactDigest",
          "requirementId",
          "requirementRevision",
          "requirementSchemaRef",
          "requirementDigest",
          "verificationEvidenceId",
          "verificationEvidenceDigest",
          "verificationResultRef",
          "referenceDigest"
        ]
      },
      "maxItems": 256
    },
    "artifactSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifestDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "manifestId",
    "libraRunId",
    "items",
    "artifactSetDigest",
    "manifestDigest"
  ],
  "x-helix-maxCanonicalBytes": 262144
}
