{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/VerifiedArtifactManifest/v1",
  "title": "VerifiedArtifactManifest@1",
  "x-helix-ssotRefs": [
    "8.6.20"
  ],
  "x-helix-role": "accepted-business-dto",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/domain-types/VerifiedArtifactManifest/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "objectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifestDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifactHandles": {
      "type": "array",
      "items": {
        "$ref": "helix://contracts/types/ArtifactHandle/v1"
      },
      "maxItems": 1024
    },
    "verificationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "objectId",
    "revision",
    "digest",
    "manifestDigest",
    "artifactHandles",
    "verificationId"
  ]
}
