{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/StructuredRejection/v1",
  "title": "StructuredRejection@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "accepted-business-dto",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "handoffKind": {
      "const": "libra_to_arca"
    },
    "offerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "deliverableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "rejectionCode": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceEvidenceSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "rejectionDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "handoffKind",
    "offerId",
    "deliverableId",
    "rejectionCode",
    "acceptanceEvidenceSetDigest",
    "rejectionDigest"
  ],
  "x-helix-maxCanonicalBytes": 16384
}
