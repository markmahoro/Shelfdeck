{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/AcceptedIntakePayload/v1",
  "title": "AcceptedIntakePayload@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "accepted-business-dto",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "intakeDecisionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "decisionRevision": {
      "const": 1
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "candidatePackageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "packageRevision": {
          "type": "integer",
          "minimum": 1
        },
        "packageDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "acceptanceBasisDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidateDeliverySnapshotDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "offerId",
        "candidatePackageId",
        "packageRevision",
        "packageDigest",
        "acceptanceBasisDigest",
        "candidateDeliverySnapshotDigest"
      ]
    },
    "sourceProvenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fieldId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "fieldAccessRevision": {
          "type": "integer",
          "minimum": 1
        },
        "fieldContextDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "structureKind": {
          "type": "string",
          "enum": [
            "single",
            "season"
          ]
        },
        "contentProfile": {
          "type": "string",
          "enum": [
            "movie",
            "series",
            "jav",
            "western_adult"
          ]
        },
        "materialInputForm": {
          "type": "string",
          "enum": [
            "stream_file",
            "bdmv",
            "dvd",
            "iso"
          ]
        },
        "identityClaimDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "fieldId",
        "fieldAccessRevision",
        "fieldContextDigest",
        "structureKind",
        "contentProfile",
        "materialInputForm",
        "identityClaimDigest"
      ]
    },
    "candidateVerification": {
      "$ref": "helix://contracts/types/CandidateContractVerification/v1"
    },
    "materialVerification": {
      "$ref": "helix://contracts/types/IntakeMaterialVerification/v1"
    },
    "resolutionDecision": {
      "$ref": "helix://contracts/domain-types/SubjectContinuityResolutionDecision/v1"
    },
    "bindingDraft": {
      "$ref": "helix://contracts/types/LibraBindingDraft/v1"
    },
    "controlTransferScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fieldId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "fromOwnerDomain": {
          "const": "procurement"
        },
        "fromOwnerScopeType": {
          "const": "material_field"
        },
        "fromOwnerScopeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "materialKey": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              },
              "expectedControlRevision": {
                "type": "integer",
                "minimum": 0
              },
              "expectedControlProjectionDigest": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              },
              "toOwnerDomain": {
                "const": "libra"
              },
              "toOwnerScopeType": {
                "const": "subject"
              },
              "toOwnerScopeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "materialKey",
              "expectedControlRevision",
              "expectedControlProjectionDigest",
              "toOwnerDomain",
              "toOwnerScopeType",
              "toOwnerScopeId"
            ]
          },
          "maxItems": 256,
          "minItems": 1
        },
        "controlScopeDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "fieldId",
        "fromOwnerDomain",
        "fromOwnerScopeType",
        "fromOwnerScopeId",
        "items",
        "controlScopeDigest"
      ]
    },
    "payloadDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "intakeDecisionId",
    "decisionRevision",
    "delivery",
    "sourceProvenance",
    "candidateVerification",
    "materialVerification",
    "resolutionDecision",
    "bindingDraft",
    "controlTransferScope",
    "payloadDigest"
  ]
}
