{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/MediaRequirement/v1",
  "title": "MediaRequirement@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "bounded-contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requirementId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "schemaRef": {
      "const": "MediaRequirement@1"
    },
    "acceptanceSpecId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "acceptanceSpecRecordDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "contentProfile": {
      "type": "string",
      "enum": [
        "movie",
        "series",
        "jav",
        "western_adult"
      ]
    },
    "structureKind": {
      "type": "string",
      "enum": [
        "single",
        "season"
      ]
    },
    "mandatoryMedia": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mediaForm": {
          "type": "string",
          "enum": [
            "any",
            "stream_file"
          ]
        },
        "videoCodec": {
          "type": "string",
          "enum": [
            "any",
            "hevc"
          ]
        },
        "container": {
          "type": "string",
          "enum": [
            "any",
            "matroska"
          ]
        },
        "fileExtension": {
          "type": "string",
          "enum": [
            "any",
            "mkv"
          ]
        },
        "minimumRasterClass": {
          "type": "string",
          "enum": [
            "none",
            "4k"
          ]
        },
        "acceptedPrimaryAudioClasses": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "eac3_atmos",
              "truehd",
              "truehd_atmos",
              "dts_hd_ma",
              "dts_x"
            ]
          },
          "maxItems": 5
        },
        "forbidSystemUpscaleFor4k": {
          "type": "boolean"
        }
      },
      "required": [
        "mediaForm",
        "videoCodec",
        "container",
        "fileExtension",
        "minimumRasterClass",
        "acceptedPrimaryAudioClasses",
        "forbidSystemUpscaleFor4k"
      ]
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": {
          "type": "string",
          "enum": [
            "product",
            "episode"
          ]
        },
        "maxSizeGiB": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "maxSizeBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "unit",
        "maxSizeGiB",
        "maxSizeBytes"
      ]
    },
    "requirementDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "requirementId",
    "revision",
    "schemaRef",
    "acceptanceSpecId",
    "acceptanceSpecRecordDigest",
    "contentProfile",
    "structureKind",
    "mandatoryMedia",
    "space",
    "requirementDigest"
  ],
  "x-helix-maxCanonicalBytes": 16384
}
