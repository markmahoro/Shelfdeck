{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/DestructionScope/v1",
  "title": "DestructionScope@1",
  "x-helix-ssotRefs": [
    "8.6.20"
  ],
  "x-helix-role": "accepted-business-dto",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/domain-types/DestructionScope/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "objectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "destructionScopeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shelfEntryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "inventoryRevision": {
      "type": "integer",
      "minimum": 0
    },
    "memberCount": {
      "type": "integer",
      "minimum": 0
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "materialKey": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "sharedScopeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sharedVersion": {
            "type": "integer",
            "minimum": 1
          },
          "materialRole": {
            "type": "string",
            "enum": [
              "primary_payload",
              "structural_dependency",
              "metadata_sidecar",
              "poster",
              "fanart",
              "subtitle",
              "external_audio",
              "chapter",
              "sidecar"
            ]
          },
          "physicalIdentity": {
            "$ref": "helix://contracts/types/PhysicalMaterialIdentity/v2"
          },
          "physicalIdentityDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "endpointId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "endpointRelativeLocation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "relatedReferenceId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "bindingRevision": {
            "type": "integer",
            "minimum": 1
          },
          "controlRevision": {
            "type": "integer",
            "minimum": 1
          },
          "controlProjectionDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "deleteCondition": {
            "type": "string",
            "enum": [
              "exclusive_primary",
              "release_related_then_delete_if_unreferenced",
              "series_last_reference"
            ]
          },
          "memberDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "ordinal",
          "materialKey",
          "materialRole",
          "physicalIdentity",
          "physicalIdentityDigest",
          "endpointId",
          "endpointRelativeLocation",
          "sizeBytes",
          "relatedReferenceId",
          "bindingRevision",
          "controlRevision",
          "controlProjectionDigest",
          "deleteCondition",
          "memberDigest"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "deleteCondition": {
                  "const": "series_last_reference"
                }
              },
              "required": [
                "deleteCondition"
              ]
            },
            "then": {
              "required": [
                "sharedScopeId",
                "sharedVersion"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "sharedScopeId"
                    ]
                  },
                  {
                    "required": [
                      "sharedVersion"
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      "maxItems": 1027
    },
    "memberSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "controlRevisionSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "scopeDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "objectId",
    "revision",
    "digest",
    "destructionScopeId",
    "shelfEntryId",
    "inventoryRevision",
    "memberCount",
    "materials",
    "memberSetDigest",
    "controlRevisionSetDigest",
    "scopeDigest"
  ]
}
