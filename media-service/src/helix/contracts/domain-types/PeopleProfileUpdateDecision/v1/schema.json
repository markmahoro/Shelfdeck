{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/PeopleProfileUpdateDecision/v1",
  "title": "PeopleProfileUpdateDecision@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "accepted-business-dto",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decisionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "personId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "expectedPersonRevision": {
      "type": "integer",
      "minimum": 1
    },
    "canonicalName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "aliasDisplay": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "aliasNormalized": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "provenanceDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "aliasDisplay",
          "aliasNormalized",
          "provenanceDigest"
        ]
      },
      "maxItems": 33
    },
    "actorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "requestDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "decisionDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "decisionId",
    "personId",
    "expectedPersonRevision",
    "canonicalName",
    "aliases",
    "actorId",
    "requestDigest",
    "decisionDigest"
  ]
}
