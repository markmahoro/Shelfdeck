{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/PeopleSelectedImageHandle/v1",
  "title": "PeopleSelectedImageHandle@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "bounded-contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/domain-types/PeopleSelectedImageHandle/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "uploadId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "digestHex": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10485760
    },
    "mediaType": {
      "type": "string",
      "enum": [
        "image/jpeg",
        "image/png",
        "image/webp"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "user_upload",
            "stashbox"
          ]
        },
        "sourceObjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sourcePageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "selectedAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "configRevision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "source"
      ]
    },
    "handleDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "uploadId",
    "digestHex",
    "sizeBytes",
    "mediaType",
    "provenance",
    "handleDigest"
  ],
  "x-helix-maxCanonicalBytes": 16384
}
