{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/MetadataObservationSet/v1",
  "title": "MetadataObservationSet@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "accepted-business-dto",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "setId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "contentProfile": {
      "type": "string",
      "enum": [
        "movie",
        "season",
        "jav",
        "western_adult"
      ]
    },
    "resolvedIdentityDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "helix://contracts/types/MetadataObservation/v1"
      },
      "maxItems": 16
    },
    "sourcePrecedence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "maxItems": 16
    },
    "setDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "setId",
    "contentProfile",
    "resolvedIdentityDigest",
    "observations",
    "sourcePrecedence",
    "setDigest"
  ]
}
