{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/TriageManifestBuildInput/v1",
  "title": "TriageManifestBuildInput@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "accepted-business-dto",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "procurementRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "runBasisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "triageRuleAuthorityDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "selectedFieldMaterialSet": {
      "$ref": "helix://contracts/domain-types/SelectedFieldMaterialSet/v1"
    },
    "structureEvidenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "structureEvidencePayloadDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unitId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "mediaType": {
          "type": "string",
          "enum": [
            "single",
            "group"
          ]
        },
        "contentProfile": {
          "type": "string",
          "enum": [
            "movie",
            "series",
            "jav",
            "western_adult"
          ]
        },
        "structureKind": {
          "type": "string",
          "enum": [
            "single",
            "season"
          ]
        },
        "displayIdentity": {
          "type": "string",
          "minLength": 1
        },
        "identityMetadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "claimedTitle": {
              "type": "string",
              "minLength": 1
            },
            "claimedYear": {
              "type": "integer",
              "minimum": 1
            },
            "seasonClaim": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "claimKind": {
                  "type": "string",
                  "enum": [
                    "explicit_number",
                    "provisional_group"
                  ]
                },
                "seasonNumber": {
                  "type": "integer",
                  "minimum": 1
                },
                "provisionalGroupKey": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-f0-9]{64}$"
                },
                "claimDigest": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "claimKind",
                "claimDigest"
              ]
            },
            "javCode": {
              "type": "string",
              "minLength": 1
            },
            "contentProfileHint": {
              "type": "string",
              "enum": [
                "movie",
                "series",
                "jav",
                "western_adult",
                "mixed"
              ]
            },
            "sourceHints": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "hintKind": {
                    "type": "string",
                    "enum": [
                      "field_content_profile_hint",
                      "filename_title",
                      "directory_title",
                      "filename_year",
                      "directory_year",
                      "filename_season",
                      "directory_season",
                      "filename_episode",
                      "jav_code",
                      "disc_structure",
                      "temporary_label"
                    ]
                  },
                  "hintValue": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidenceDigest": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "hintKind",
                  "hintValue",
                  "evidenceDigest"
                ]
              },
              "maxItems": 256
            },
            "metadataDigest": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "claimedTitle",
            "contentProfileHint",
            "sourceHints",
            "metadataDigest"
          ]
        },
        "seasonContinuityClaims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "exact_provider_season",
                  "persistent_triage_grouping"
                ]
              },
              "namespace": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "claimDigest": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              },
              "evidenceDigest": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "kind",
              "namespace",
              "key",
              "claimDigest",
              "evidenceDigest"
            ]
          },
          "maxItems": 64
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "materialKey": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              },
              "bindingRevision": {
                "type": "integer",
                "minimum": 1
              },
              "admittedControlRevision": {
                "type": "integer",
                "minimum": 1
              },
              "admittedControlProjectionDigest": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              },
              "role": {
                "type": "string",
                "enum": [
                  "primary_payload",
                  "structural_dependency"
                ]
              },
              "episodeClaims": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "episodeKey": {
                      "type": "string",
                      "minLength": 1
                    },
                    "seasonClaimDigest": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "claimDigest": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "episodeKey",
                    "seasonClaimDigest",
                    "claimDigest"
                  ]
                },
                "maxItems": 32
              },
              "memberClaimDigest": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "materialKey",
              "bindingRevision",
              "admittedControlRevision",
              "admittedControlProjectionDigest",
              "role",
              "episodeClaims",
              "memberClaimDigest"
            ]
          },
          "maxItems": 1024,
          "minItems": 1
        },
        "relatedReferences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "referenceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "primaryMaterialKey": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              },
              "role": {
                "type": "string",
                "enum": [
                  "nfo",
                  "poster",
                  "fanart",
                  "subtitle",
                  "external_audio",
                  "chapter",
                  "sidecar"
                ]
              },
              "identity": {
                "$ref": "helix://contracts/types/PhysicalMaterialIdentity/v1"
              },
              "endpointId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "location": {
                "type": "string",
                "minLength": 1
              },
              "checksumAlgorithm": {
                "const": "sha256"
              },
              "checksumHex": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              },
              "associationEvidenceDigest": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              },
              "referenceDigest": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "referenceId",
              "primaryMaterialKey",
              "role",
              "identity",
              "endpointId",
              "location",
              "checksumAlgorithm",
              "checksumHex",
              "associationEvidenceDigest",
              "referenceDigest"
            ]
          },
          "maxItems": 1024
        },
        "unitDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "unitId",
        "mediaType",
        "contentProfile",
        "structureKind",
        "displayIdentity",
        "identityMetadata",
        "seasonContinuityClaims",
        "members",
        "relatedReferences",
        "unitDigest"
      ]
    },
    "preallocatedManifestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "inputDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "procurementRunId",
    "runBasisDigest",
    "triageRuleAuthorityDigest",
    "selectedFieldMaterialSet",
    "structureEvidenceId",
    "structureEvidencePayloadDigest",
    "unit",
    "preallocatedManifestId",
    "inputDigest"
  ]
}
