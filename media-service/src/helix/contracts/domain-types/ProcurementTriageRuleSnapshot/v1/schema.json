{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/ProcurementTriageRuleSnapshot/v1",
  "title": "ProcurementTriageRuleSnapshot@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "accepted-business-dto",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ruleRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "ruleSchemaRef": {
      "const": "procurement.triage-rule.beta@1"
    },
    "rulePayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selectionScopeRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "const": 3
            },
            "categoryDirectories": {
              "const": "containers"
            },
            "seriesKey": {
              "const": "local_claimed_title_and_season"
            },
            "provisionalSeasonBoundary": {
              "const": "direct_parent"
            },
            "ordinaryPayload": {
              "const": "independent"
            },
            "javNamedParts": {
              "const": "direct_parent_and_canonical_code"
            },
            "bdmv": {
              "const": "whole_container_with_certificate"
            },
            "dvd": {
              "const": "whole_video_ts_container"
            },
            "ordering": {
              "const": "canonical_utf8"
            },
            "packing": {
              "const": "sequential_complete_groups"
            }
          },
          "required": [
            "revision",
            "categoryDirectories",
            "seriesKey",
            "provisionalSeasonBoundary",
            "ordinaryPayload",
            "javNamedParts",
            "bdmv",
            "dvd",
            "ordering",
            "packing"
          ]
        },
        "contractRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 32
        },
        "recallPriority": {
          "const": true
        },
        "maxRunPhysicalMembers": {
          "const": 1024
        },
        "maxSelectionScopeMembers": {
          "const": 1024
        },
        "maxCandidateManifestMembers": {
          "const": 1024
        },
        "probeBatchSize": {
          "const": 100
        },
        "playabilityRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimumDurationMs": {
              "const": 1
            },
            "minimumVideoStreamCount": {
              "const": 1
            },
            "reasonPrecedence": {
              "const": [
                "probe_not_media",
                "no_video_stream",
                "non_positive_duration"
              ]
            }
          },
          "required": [
            "minimumDurationMs",
            "minimumVideoStreamCount",
            "reasonPrecedence"
          ]
        },
        "profileResolutionRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mixedPrecedence": {
              "const": [
                "series_episode_token",
                "jav_code",
                "movie_fallback"
              ]
            },
            "westernAdultRequiresExplicitHint": {
              "const": true
            }
          },
          "required": [
            "mixedPrecedence",
            "westernAdultRequiresExplicitHint"
          ]
        },
        "structureRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxUnitCanonicalBytes": {
              "const": 65536
            },
            "maxSeriesUnitCanonicalBytes": {
              "const": 8388608
            }
          },
          "required": [
            "maxUnitCanonicalBytes",
            "maxSeriesUnitCanonicalBytes"
          ]
        },
        "identityRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "claimKinds": {
              "const": [
                "movie_title",
                "series_season",
                "jav_code",
                "western_temporary"
              ]
            }
          },
          "required": [
            "claimKinds"
          ]
        },
        "javNamedPartsRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profiles": {
              "const": [
                "jav",
                "mixed"
              ]
            },
            "labels": {
              "const": [
                "A",
                "B"
              ]
            },
            "parentBoundary": {
              "const": "direct_parent"
            },
            "identityRule": {
              "const": "canonical_jav_code"
            },
            "memberOrder": {
              "const": "part_label"
            },
            "requireCompleteLabelSet": {
              "const": false
            },
            "singleMemberInputForm": {
              "const": "stream_file"
            },
            "multipleMemberInputForm": {
              "const": "jav_named_parts"
            }
          },
          "required": [
            "profiles",
            "labels",
            "parentBoundary",
            "identityRule",
            "memberOrder",
            "requireCompleteLabelSet",
            "singleMemberInputForm",
            "multipleMemberInputForm"
          ]
        },
        "manifestRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimumMembers": {
              "const": 1
            },
            "maximumMembers": {
              "const": 1024
            },
            "firstOrdinal": {
              "const": 0
            }
          },
          "required": [
            "minimumMembers",
            "maximumMembers",
            "firstOrdinal"
          ]
        }
      },
      "required": [
        "selectionScopeRule",
        "contractRefs",
        "recallPriority",
        "maxRunPhysicalMembers",
        "maxSelectionScopeMembers",
        "maxCandidateManifestMembers",
        "probeBatchSize",
        "playabilityRule",
        "profileResolutionRule",
        "structureRule",
        "identityRule",
        "javNamedPartsRule",
        "manifestRule"
      ]
    },
    "ruleDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "authorityDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "ruleRef",
    "revision",
    "ruleSchemaRef",
    "rulePayload",
    "ruleDigest",
    "authorityDigest"
  ]
}
