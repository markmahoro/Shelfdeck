{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/WorkspaceMediaOutputTarget/v1",
  "title": "WorkspaceMediaOutputTarget@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "accepted-business-dto",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "targetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "libraRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "executionBasisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "expectedWorkspaceRevision": {
      "type": "integer",
      "minimum": 1
    },
    "expectedWorkspaceStateDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "rootSnapshot": {
      "$ref": "helix://contracts/application-types/PlatformWorkspaceRootSnapshot/v1"
    },
    "workspaceScopeDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "targetRelativePath": {
      "type": "string",
      "minLength": 1
    },
    "outputRole": {
      "const": "product_media"
    },
    "productionIntentDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "effectScopeDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "targetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "targetId",
    "libraRunId",
    "executionBasisDigest",
    "workspaceId",
    "expectedWorkspaceRevision",
    "expectedWorkspaceStateDigest",
    "rootSnapshot",
    "workspaceScopeDigest",
    "targetRelativePath",
    "outputRole",
    "productionIntentDigest",
    "effectScopeDigest",
    "targetDigest"
  ],
  "x-helix-maxCanonicalBytes": 16384
}
