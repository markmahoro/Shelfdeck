{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/IdentityRequirement/v1",
  "title": "IdentityRequirement@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "bounded-contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requirementId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "schemaRef": {
      "const": "IdentityRequirement@1"
    },
    "expectedIdentityDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "strengthClass": {
      "const": "exact_provider_identity"
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "requirementId",
    "revision",
    "schemaRef",
    "expectedIdentityDigest",
    "strengthClass",
    "digest"
  ],
  "x-helix-maxCanonicalBytes": 16384
}
