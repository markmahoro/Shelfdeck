{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/PersonReferenceProjection/v1",
  "title": "PersonReferenceProjection@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "accepted-business-dto",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "projectionContract": {
      "const": "people.person-reference-projection@1"
    },
    "projectionRevision": {
      "type": "integer",
      "minimum": 1
    },
    "personId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "personRevision": {
      "type": "integer",
      "minimum": 1
    },
    "currentReferenceRevision": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ]
    },
    "contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ownerPersonId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "ownerReferenceRevision": {
            "type": "integer",
            "minimum": 1
          },
          "referenceSetDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "inheritedReadOnly": {
            "type": "boolean"
          },
          "activeAssets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "referenceAssetId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "artifactHandleId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "artifactDigest": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "referenceAssetId",
                "artifactHandleId",
                "artifactDigest"
              ]
            },
            "maxItems": 1024
          },
          "activeFaces": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "referenceFaceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "referenceAssetId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "embeddingHandleId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "embeddingDigest": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-f0-9]{64}$"
                },
                "modelRef": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              },
              "required": [
                "referenceFaceId",
                "referenceAssetId",
                "embeddingHandleId",
                "embeddingDigest",
                "modelRef"
              ]
            },
            "maxItems": 1024
          }
        },
        "required": [
          "ownerPersonId",
          "ownerReferenceRevision",
          "referenceSetDigest",
          "inheritedReadOnly",
          "activeAssets",
          "activeFaces"
        ]
      },
      "maxItems": 4096
    },
    "projectionDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "projectionContract",
    "projectionRevision",
    "personId",
    "personRevision",
    "currentReferenceRevision",
    "contributions",
    "projectionDigest"
  ]
}
