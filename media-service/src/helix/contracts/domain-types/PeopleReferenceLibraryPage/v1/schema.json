{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/PeopleReferenceLibraryPage/v1",
  "title": "PeopleReferenceLibraryPage@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "accepted-business-dto",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/domain-types/PeopleReferenceLibraryPage/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "libraryKind": {
      "const": "us_adult"
    },
    "libraryDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "totalPersonCount": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "helix://contracts/domain-types/UsAdultPersonSnapshot/v1"
      },
      "maxItems": 256
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "pageDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "libraryKind",
    "libraryDigest",
    "totalPersonCount",
    "items",
    "nextCursor",
    "pageDigest"
  ],
  "x-helix-maxCanonicalBytes": 524288
}
