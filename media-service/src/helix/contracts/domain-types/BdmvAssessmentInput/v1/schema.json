{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/BdmvAssessmentInput/v1",
  "title": "BdmvAssessmentInput@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "accepted-business-dto",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "bdmvGroupKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scopeDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "memberSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "accessRevision": {
      "type": "integer",
      "minimum": 1
    },
    "mountScopeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "profileHint": {
      "type": "string",
      "enum": [
        "movie",
        "series",
        "jav",
        "western_adult",
        "mixed"
      ]
    },
    "inputDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "runId",
    "bdmvGroupKey",
    "scopeDigest",
    "memberSetDigest",
    "accessRevision",
    "mountScopeId",
    "profileHint",
    "inputDigest"
  ]
}
