{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/WesternAnalysisVariant/v1",
  "title": "WesternAnalysisVariant@1",
  "x-helix-ssotRefs": [
    "6.4.7.1",
    "8.6.20"
  ],
  "x-helix-role": "accepted-business-dto",
  "x-helix-maxCanonicalBytes": 262144,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "variantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "libraRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "runExecutionBasisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "resolvedIdentityDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "analysisResults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "resultId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "resultDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "result": {
            "$ref": "helix://contracts/types/WesternAnalysisResult/v1"
          }
        },
        "required": [
          "eventId",
          "resultId",
          "resultDigest",
          "result"
        ]
      },
      "maxItems": 16,
      "minItems": 1
    },
    "variantDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "variantId",
    "libraRunId",
    "runExecutionBasisDigest",
    "resolvedIdentityDigest",
    "analysisResults",
    "variantDigest"
  ]
}
