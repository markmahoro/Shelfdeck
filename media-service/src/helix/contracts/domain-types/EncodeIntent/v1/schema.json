{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/EncodeIntent/v1",
  "title": "EncodeIntent@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "bounded-contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "intentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "schemaRef": {
      "const": "EncodeIntent@1"
    },
    "libraRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sourceHandleDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "mediaRequirementDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "outputContainer": {
      "const": "matroska"
    },
    "outputExtension": {
      "const": "mkv"
    },
    "video": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "codec": {
              "const": "hevc"
            },
            "preserveRaster": {
              "const": true
            },
            "forbidUpscale": {
              "const": true
            },
            "rateControlMode": {
              "const": "target_size"
            },
            "targetVideoBitrateBps": {
              "type": "integer",
              "minimum": 1
            },
            "qualityBound": {
              "type": "null"
            }
          },
          "required": [
            "codec",
            "preserveRaster",
            "forbidUpscale",
            "rateControlMode",
            "targetVideoBitrateBps",
            "qualityBound"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "codec": {
              "const": "hevc"
            },
            "preserveRaster": {
              "const": true
            },
            "forbidUpscale": {
              "const": true
            },
            "rateControlMode": {
              "const": "quality_bound"
            },
            "targetVideoBitrateBps": {
              "type": "null"
            },
            "qualityBound": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            }
          },
          "required": [
            "codec",
            "preserveRaster",
            "forbidUpscale",
            "rateControlMode",
            "targetVideoBitrateBps",
            "qualityBound"
          ]
        }
      ]
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "copy"
        }
      },
      "required": [
        "mode"
      ]
    },
    "subtitle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "copy"
        }
      },
      "required": [
        "mode"
      ]
    },
    "deviceClass": {
      "type": "string",
      "enum": [
        "software_cpu",
        "intel_qsv",
        "nvidia_nvenc",
        "amd_vaapi",
        "remote_worker"
      ]
    },
    "intentDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "intentId",
    "revision",
    "schemaRef",
    "libraRunId",
    "sourceHandleDigest",
    "mediaRequirementDigest",
    "outputContainer",
    "outputExtension",
    "video",
    "audio",
    "subtitle",
    "deviceClass",
    "intentDigest"
  ],
  "x-helix-maxCanonicalBytes": 16384
}
