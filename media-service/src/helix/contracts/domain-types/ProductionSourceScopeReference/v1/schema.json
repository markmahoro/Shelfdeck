{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/ProductionSourceScopeReference/v1",
  "title": "ProductionSourceScopeReference@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "bounded-contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "ProductionSourceScopeReference@1"
    },
    "schemaVersion": {
      "const": 1
    },
    "libraRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scopeKind": {
      "type": "string",
      "enum": [
        "stream_file",
        "bdmv",
        "dvd",
        "iso",
        "jav_named_parts"
      ]
    },
    "scopeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scopeDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "memberSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "memberCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "selectedPayloadSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceReferenceDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "workspaceMaterialHandle": {
      "$ref": "helix://contracts/types/WorkspaceMaterialHandle/v1"
    },
    "javPartSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "javCode",
        "parentRelativeLocation",
        "parts",
        "groupDigest"
      ],
      "properties": {
        "schema": {
          "const": "procurement.jav-named-part-group@1"
        },
        "javCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "parentRelativeLocation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ordinal",
              "partLabel",
              "materialKey",
              "relativeLocation"
            ],
            "properties": {
              "ordinal": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "partLabel": {
                "enum": [
                  "A",
                  "B"
                ]
              },
              "materialKey": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "relativeLocation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          }
        },
        "groupDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "x-helix-maxCanonicalBytes": 16384
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "libraRunId",
    "scopeKind",
    "scopeId",
    "scopeDigest",
    "memberSetDigest",
    "memberCount",
    "selectedPayloadSetDigest",
    "sourceReferenceDigest"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "scopeKind": {
            "const": "jav_named_parts"
          }
        },
        "required": [
          "scopeKind"
        ]
      },
      "then": {
        "required": [
          "javPartSet"
        ],
        "properties": {
          "memberCount": {
            "const": 2
          },
          "javPartSet": {
            "properties": {
              "parts": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        "not": {
          "required": [
            "workspaceMaterialHandle"
          ]
        }
      },
      "else": {
        "not": {
          "required": [
            "javPartSet"
          ]
        }
      }
    }
  ],
  "x-helix-maxCanonicalBytes": 16384
}
