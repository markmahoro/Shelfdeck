{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/MandatoryRequirement/v1",
  "title": "MandatoryRequirement@1",
  "x-helix-ssotRefs": [
    "5.7.1",
    "8.6.9",
    "8.6.20"
  ],
  "x-helix-role": "bounded-contract",
  "x-helix-maxCanonicalBytes": 16384,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/domain-types/MandatoryRequirement/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "requirementId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "shelfId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shelfStandardRevision": {
      "type": "integer",
      "minimum": 1
    },
    "shelfStandardDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "contentProfile": {
      "type": "string",
      "enum": [
        "movie",
        "series",
        "jav",
        "western_adult"
      ]
    },
    "mediaForm": {
      "type": "string",
      "enum": [
        "any",
        "stream_file"
      ]
    },
    "videoCodec": {
      "type": "string",
      "enum": [
        "any",
        "hevc"
      ]
    },
    "container": {
      "type": "string",
      "enum": [
        "any",
        "matroska"
      ]
    },
    "fileExtension": {
      "type": "string",
      "enum": [
        "any",
        "mkv"
      ]
    },
    "minimumRasterClass": {
      "type": "string",
      "enum": [
        "none",
        "720p",
        "1080p",
        "4k"
      ]
    },
    "acceptedPrimaryAudioClasses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 128,
      "uniqueItems": true
    },
    "maxSizeBytes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "forbidSystemUpscaleFor4k": {
      "type": "boolean"
    },
    "acceptedOutputDynamicRangeKinds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "sdr",
          "hdr10_compatible",
          "hlg",
          "dolby_vision",
          "unknown"
        ]
      },
      "maxItems": 5,
      "minItems": 1,
      "uniqueItems": true
    },
    "sdrOutputPixelFormat": {
      "const": "yuv420p"
    },
    "sdrOutputColorProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "range": {
          "const": "limited"
        },
        "primaries": {
          "const": "bt709"
        },
        "transfer": {
          "const": "bt709"
        },
        "matrix": {
          "const": "bt709"
        }
      },
      "required": [
        "range",
        "primaries",
        "transfer",
        "matrix"
      ]
    },
    "forbidDolbyVisionMetadataOnSdr": {
      "const": true
    },
    "decodeSamplePointsPercent": {
      "type": "array",
      "prefixItems": [
        {
          "const": 5
        },
        {
          "const": 50
        },
        {
          "const": 95
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "requireAllDecodeSamples": {
      "const": true
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "requirementId",
    "revision",
    "digest",
    "shelfId",
    "shelfStandardRevision",
    "shelfStandardDigest",
    "contentProfile",
    "mediaForm",
    "videoCodec",
    "container",
    "fileExtension",
    "minimumRasterClass",
    "acceptedPrimaryAudioClasses",
    "maxSizeBytes",
    "forbidSystemUpscaleFor4k",
    "acceptedOutputDynamicRangeKinds",
    "sdrOutputPixelFormat",
    "sdrOutputColorProfile",
    "forbidDolbyVisionMetadataOnSdr",
    "decodeSamplePointsPercent",
    "requireAllDecodeSamples"
  ]
}
