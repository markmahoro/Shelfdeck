{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/FinalReality/v1",
  "title": "FinalReality@1",
  "x-helix-ssotRefs": [
    "8.6.20"
  ],
  "x-helix-role": "accepted-business-dto",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/domain-types/FinalReality/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "objectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "shelfEntryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "inventoryRevision": {
      "type": "integer",
      "minimum": 0
    },
    "realityDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "observedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "memberEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceProductMaterialKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "verificationKind": {
            "type": "string",
            "enum": [
              "exact_package_identity",
              "semantic_presentation"
            ]
          },
          "actualPhysicalIdentity": {
            "$ref": "helix://contracts/types/PhysicalMaterialIdentity/v2"
          },
          "observedAtMs": {
            "type": "integer",
            "minimum": 0
          },
          "semanticEvidenceDigest": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "sourceProductMaterialKey",
          "role",
          "verificationKind",
          "actualPhysicalIdentity",
          "observedAtMs",
          "semanticEvidenceDigest"
        ]
      },
      "maxItems": 4096
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "objectId",
    "revision",
    "digest",
    "shelfEntryId",
    "inventoryRevision",
    "realityDigest",
    "observedAtMs",
    "memberEvidence"
  ]
}
