{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/domain-types/ProductionMaterialManifest/v1",
  "title": "ProductionMaterialManifest@1",
  "x-helix-ssotRefs": [
    "8.6.13",
    "8.6.18",
    "8.6.20"
  ],
  "x-helix-role": "accepted-business-dto",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "manifestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "manifestRole": {
      "const": "product_delivery"
    },
    "manifestRevision": {
      "type": "integer",
      "minimum": 1
    },
    "libraRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "materialKey": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "primary_payload",
              "structural_dependency",
              "metadata_sidecar",
              "poster",
              "fanart",
              "subtitle",
              "external_audio",
              "chapter"
            ]
          },
          "physicalIdentity": {
            "$ref": "helix://contracts/types/PhysicalMaterialIdentity/v1"
          },
          "locationKind": {
            "type": "string",
            "enum": [
              "domain_binding",
              "workspace_handle"
            ]
          },
          "endpointId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "location": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "rootHandleRef": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "relativePath": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "bindingKind": {
            "type": "string",
            "enum": [
              "libra_material_binding",
              "workspace_material_reference"
            ]
          },
          "bindingRevision": {
            "type": "integer",
            "minimum": 1
          },
          "bindingEvidenceDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "episodeClaims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "episodeKey": {
                  "type": "string",
                  "minLength": 1
                },
                "seasonClaimDigest": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-f0-9]{64}$"
                },
                "claimDigest": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "episodeKey",
                "seasonClaimDigest",
                "claimDigest"
              ]
            },
            "maxItems": 32
          },
          "episodeClaimSetDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "outputRequirementDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "controlOperation": {
            "type": "string",
            "enum": [
              "assert_existing_input",
              "acquire_workspace_product"
            ]
          },
          "expectedControlRevision": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "expectedControlProjectionDigest": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "memberDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "ordinal",
          "materialKey",
          "role",
          "physicalIdentity",
          "locationKind",
          "endpointId",
          "location",
          "rootHandleRef",
          "relativePath",
          "bindingKind",
          "bindingRevision",
          "bindingEvidenceDigest",
          "episodeClaims",
          "episodeClaimSetDigest",
          "outputRequirementDigest",
          "controlOperation",
          "expectedControlRevision",
          "expectedControlProjectionDigest",
          "memberDigest"
        ]
      },
      "maxItems": 1024,
      "minItems": 1
    },
    "memberSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "episodeScopeDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifestDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "manifestId",
    "manifestRole",
    "manifestRevision",
    "libraRunId",
    "members",
    "memberSetDigest",
    "episodeScopeDigest",
    "manifestDigest"
  ]
}
