{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/application-types/AuthorizedDefectManifest/v1",
  "title": "AuthorizedDefectManifest@1",
  "x-helix-ssotRefs": [
    "5.6.7",
    "5.7.2",
    "5.8.2",
    "8.6.21"
  ],
  "x-helix-maxCanonicalBytes": 65536,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/application-types/AuthorizedDefectManifest/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "manifestId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "defectDecisionId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "libraRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "frozenRunRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stateRevision": {
          "type": "integer",
          "minimum": 1
        },
        "stateDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "stateRevision",
        "stateDigest"
      ]
    },
    "candidateRevision": {
      "type": "integer",
      "minimum": 1
    },
    "candidateDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "terminalEvidenceDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "defects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "defectCode": {
            "type": "string",
            "enum": [
              "actor_unavailable",
              "metadata_fields_unavailable",
              "artifacts_unavailable",
              "external_source_exhausted",
              "media_requirements_unmet",
              "size_cap_exceeded"
            ]
          },
          "artifactKindCodes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "nfo",
                "poster",
                "fanart"
              ]
            }
          },
          "metadataFieldCodes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "sourceFailureCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sourceWorkId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sourceEvidenceDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "originalMediaVerificationId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "originalMediaVerificationDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "workspaceMediaVerificationId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "workspaceMediaVerificationDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "candidateBasisDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "productMaterialHandleId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "productMaterialHandleDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "productMaterialFenceDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "workspaceMediaHandleId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "waivedRequirementCodes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 14,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "metadata_field_unmet",
                "video_codec_unmet",
                "container_unmet",
                "file_extension_unmet",
                "minimum_raster_unmet",
                "system_upscale_forbidden",
                "primary_audio_unmet",
                "max_size_exceeded",
                "dynamic_range_conversion_unmet",
                "output_color_profile_unmet",
                "dolby_vision_metadata_not_removed",
                "metadata_artifact_unmet",
                "sidecar_unrenderable",
                "image_undecodable"
              ]
            }
          }
        },
        "required": [
          "defectCode",
          "sourceFailureCode",
          "sourceWorkId",
          "sourceEvidenceDigest",
          "waivedRequirementCodes"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "defectCode": {
                  "enum": [
                    "external_source_exhausted",
                    "media_requirements_unmet"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "originalMediaVerificationId",
                "originalMediaVerificationDigest"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "originalMediaVerificationId"
                    ]
                  },
                  {
                    "required": [
                      "originalMediaVerificationDigest"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "defectCode": {
                  "const": "size_cap_exceeded"
                }
              }
            },
            "then": {
              "required": [
                "workspaceMediaVerificationId",
                "workspaceMediaVerificationDigest",
                "candidateBasisDigest",
                "productMaterialHandleId",
                "productMaterialHandleDigest",
                "productMaterialFenceDigest",
                "workspaceMediaHandleId"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "workspaceMediaVerificationId"
                    ]
                  },
                  {
                    "required": [
                      "workspaceMediaVerificationDigest"
                    ]
                  },
                  {
                    "required": [
                      "candidateBasisDigest"
                    ]
                  },
                  {
                    "required": [
                      "productMaterialHandleId"
                    ]
                  },
                  {
                    "required": [
                      "productMaterialHandleDigest"
                    ]
                  },
                  {
                    "required": [
                      "productMaterialFenceDigest"
                    ]
                  },
                  {
                    "required": [
                      "workspaceMediaHandleId"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "defectCount": {
      "type": "integer",
      "minimum": 1
    },
    "waivedRequirementCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "metadata_field_unmet",
          "video_codec_unmet",
          "container_unmet",
          "file_extension_unmet",
          "minimum_raster_unmet",
          "system_upscale_forbidden",
          "primary_audio_unmet",
          "max_size_exceeded",
          "dynamic_range_conversion_unmet",
          "output_color_profile_unmet",
          "dolby_vision_metadata_not_removed",
          "metadata_artifact_unmet",
          "sidecar_unrenderable",
          "image_undecodable"
        ]
      }
    },
    "actorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "acknowledgement": {
      "const": "accept_listed_defects"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "decidedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "manifestDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "standingAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authorizationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "authorizationDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "authorizationId",
        "revision",
        "authorizationDigest"
      ]
    },
    "authorizationSource": {
      "enum": [
        "manual",
        "standing"
      ]
    },
    "gapScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ownerDomain": {
          "const": "libra"
        },
        "processId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "productRevision": {
          "type": "integer",
          "minimum": 1
        },
        "acceptanceSpecId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "acceptanceSpecRecordDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "requirementsDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "productEvidenceDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "gaps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requirementCode": {
                "type": "string",
                "enum": [
                  "metadata_field_unmet",
                  "video_codec_unmet",
                  "container_unmet",
                  "file_extension_unmet",
                  "minimum_raster_unmet",
                  "system_upscale_forbidden",
                  "primary_audio_unmet",
                  "max_size_exceeded",
                  "dynamic_range_conversion_unmet",
                  "output_color_profile_unmet",
                  "dolby_vision_metadata_not_removed",
                  "metadata_artifact_unmet",
                  "sidecar_unrenderable",
                  "image_undecodable"
                ]
              },
              "targetKind": {
                "enum": [
                  "metadata_field",
                  "media",
                  "artifact"
                ]
              },
              "targetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "evidenceDigest": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              },
              "requiredValueDigest": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "requirementCode",
              "targetKind",
              "targetId",
              "evidenceDigest",
              "requiredValueDigest"
            ]
          }
        }
      },
      "required": [
        "ownerDomain",
        "processId",
        "productRevision",
        "acceptanceSpecId",
        "acceptanceSpecRecordDigest",
        "requirementsDigest",
        "productEvidenceDigest",
        "gaps"
      ]
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "manifestId",
    "defectDecisionId",
    "libraRunId",
    "frozenRunRef",
    "candidateRevision",
    "candidateDigest",
    "terminalEvidenceDigest",
    "defects",
    "defectCount",
    "waivedRequirementCodes",
    "actorId",
    "acknowledgement",
    "idempotencyKey",
    "decidedAtMs",
    "manifestDigest"
  ]
}
