{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/application-types/ProcurementRetryAdmissionResult/v1",
  "title": "ProcurementRetryAdmissionResult@1",
  "x-helix-ssotRefs": [
    "8.6.18"
  ],
  "x-helix-maxCanonicalBytes": 65536,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/application-types/ProcurementRetryAdmissionResult/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "receiptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "receiptKind": {
      "const": "procurement_retry_admission"
    },
    "ownerDomain": {
      "const": "procurement"
    },
    "scopeType": {
      "const": "procurement_retry_intent"
    },
    "scopeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scopeDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "committedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "retryIntentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "intentDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "terminalIntentState": {
      "type": "string",
      "enum": [
        "consumed",
        "stale"
      ]
    },
    "resultKind": {
      "type": "string",
      "enum": [
        "created",
        "stale"
      ]
    },
    "createdControlReceipt": {
      "$ref": "helix://contracts/types/ProcurementControlReceipt/v1"
    },
    "staleMaterialCount": {
      "type": "integer",
      "minimum": 1
    },
    "staleMaterialSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "staleReasonCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "field_status_changed",
          "field_access_changed",
          "terminal_observation_changed",
          "extraction_policy_changed",
          "triage_rule_changed",
          "material_not_present",
          "material_binding_changed",
          "material_not_eligible",
          "material_eligibility_changed",
          "material_guard_conflict",
          "material_control_unavailable",
          "material_control_not_acquirable",
          "material_control_changed"
        ]
      }
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "receiptId",
    "receiptKind",
    "ownerDomain",
    "scopeType",
    "scopeId",
    "scopeDigest",
    "committedAtMs",
    "retryIntentId",
    "intentDigest",
    "terminalIntentState",
    "resultKind"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "resultKind": {
            "const": "created"
          }
        }
      },
      "then": {
        "required": [
          "createdControlReceipt"
        ],
        "properties": {
          "terminalIntentState": {
            "const": "consumed"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "staleMaterialCount"
              ]
            },
            {
              "required": [
                "staleMaterialSetDigest"
              ]
            },
            {
              "required": [
                "staleReasonCodes"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "staleMaterialCount",
          "staleMaterialSetDigest",
          "staleReasonCodes"
        ],
        "properties": {
          "terminalIntentState": {
            "const": "stale"
          }
        },
        "not": {
          "required": [
            "createdControlReceipt"
          ]
        }
      }
    }
  ]
}
