{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/application-types/ArcaJavCorrectionAdmissionReceipt/v1",
  "title": "ArcaJavCorrectionAdmissionReceipt@1",
  "x-helix-ssotRefs": [
    "3.5.5",
    "8.5.12",
    "8.6.19"
  ],
  "x-helix-maxCanonicalBytes": 16384,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/application-types/ArcaJavCorrectionAdmissionReceipt/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "correctionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shelfEntryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "state": {
      "const": "admitted"
    },
    "stateRevision": {
      "const": 1
    },
    "basisDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "proposalDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "placementPreviewDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "admissionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "admittedAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "correctionId",
    "shelfEntryId",
    "state",
    "stateRevision",
    "basisDigest",
    "proposalDigest",
    "placementPreviewDigest",
    "admissionDigest",
    "admittedAtMs"
  ]
}
