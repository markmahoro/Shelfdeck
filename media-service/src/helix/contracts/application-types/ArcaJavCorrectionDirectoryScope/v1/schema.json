{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/application-types/ArcaJavCorrectionDirectoryScope/v1",
  "title": "ArcaJavCorrectionDirectoryScope@1",
  "x-helix-ssotRefs": [
    "3.5.5",
    "8.5.12",
    "8.6.19"
  ],
  "x-helix-maxCanonicalBytes": 65536,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/application-types/ArcaJavCorrectionDirectoryScope/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "correctionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shelfEntryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "committedContextDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cleanupReceiptDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "filePlanDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "targetRootLocation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "protectionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "directories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceLocation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "oldBindingOrdinals": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1024,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1023
            }
          },
          "eligibility": {
            "enum": [
              "eligible",
              "retained_root",
              "retained_in_use"
            ]
          }
        },
        "required": [
          "sourceLocation",
          "oldBindingOrdinals",
          "eligibility"
        ]
      }
    },
    "scopeDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "correctionId",
    "shelfEntryId",
    "committedContextDigest",
    "cleanupReceiptDigest",
    "filePlanDigest",
    "targetRootLocation",
    "protectionDigest",
    "directories",
    "scopeDigest"
  ]
}
