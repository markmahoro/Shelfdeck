{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/application-types/LibraDefectAuthorization/v1",
  "title": "LibraDefectAuthorization@1",
  "x-helix-ssotRefs": [
    "5.6.7",
    "8.5.13",
    "8.6.21",
    "9.5.3",
    "9.5.4"
  ],
  "x-helix-maxCanonicalBytes": 65536,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "authorizationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "state": {
      "enum": [
        "enabled",
        "revoked"
      ]
    },
    "actorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "effectiveAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "revokedAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "authorizationDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "authorizationId",
    "revision",
    "state",
    "actorId",
    "effectiveAtMs",
    "revokedAtMs",
    "authorizationDigest"
  ]
}
