{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/application-types/ArcaMaterialEpisodeClaims/v1",
  "title": "ArcaMaterialEpisodeClaims@1",
  "x-helix-ssotRefs": [
    "3.3.1",
    "8.5.13",
    "8.6.19"
  ],
  "x-helix-maxCanonicalBytes": 16384,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "episodeKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "seasonClaimDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "claimDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "episodeKey",
          "seasonClaimDigest",
          "claimDigest"
        ]
      }
    },
    "episodeClaimSetDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "items",
    "episodeClaimSetDigest"
  ]
}
