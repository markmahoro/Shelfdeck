{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/application-types/PlatformComputeDeviceQuery/v1",
  "title": "PlatformComputeDeviceQuery@1",
  "x-helix-ssotRefs": [
    "8.3.8",
    "8.6.18"
  ],
  "x-helix-maxCanonicalBytes": 4096,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "expectedProbeRevision": {
      "type": "integer",
      "minimum": 1
    },
    "expectedCapabilityDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "queryDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "deviceId",
    "queryDigest"
  ]
}
