{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/application-types/ArcaJavCorrectionDirectoryChecks/v1",
  "title": "ArcaJavCorrectionDirectoryChecks@1",
  "x-helix-ssotRefs": [
    "3.5.5",
    "8.5.12",
    "8.6.19"
  ],
  "x-helix-maxCanonicalBytes": 65536,
  "type": "array",
  "maxItems": 32,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "sourceLocation",
      "state",
      "recycleEntryId",
      "errorCode"
    ],
    "properties": {
      "sourceLocation": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "state": {
        "enum": [
          "absent",
          "retained_root",
          "retained_in_use",
          "retained_after_restore",
          "awaiting_confirmation",
          "recycle_pending",
          "archived",
          "purged",
          "blocked"
        ]
      },
      "recycleEntryId": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        ]
      },
      "errorCode": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        ]
      }
    }
  }
}
