{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/application-types/WorkspaceSpaceAdmissionEvidence/v1",
  "title": "WorkspaceSpaceAdmissionEvidence@1",
  "x-helix-ssotRefs": [
    "8.6.21"
  ],
  "x-helix-maxCanonicalBytes": 16384,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "evidenceId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "authorityRef": {
      "const": "platform.workspace-space-admission@1"
    },
    "requestDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "libraRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "rootId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "rootSnapshotDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "requiredBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "availableBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "observedAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "result": {
      "type": "string",
      "enum": [
        "admitted",
        "insufficient_space",
        "root_unavailable",
        "demand_out_of_range"
      ]
    },
    "reasonCode": {
      "type": "string",
      "enum": [
        "insufficient_space",
        "root_unavailable",
        "demand_out_of_range"
      ]
    },
    "evidenceDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "evidenceId",
    "authorityRef",
    "requestDigest",
    "workspaceId",
    "libraRunId",
    "rootId",
    "rootSnapshotDigest",
    "requiredBytes",
    "observedAtMs",
    "expiresAtMs",
    "result",
    "evidenceDigest"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "admitted"
          }
        }
      },
      "then": {
        "required": [
          "availableBytes"
        ],
        "not": {
          "required": [
            "reasonCode"
          ]
        }
      },
      "else": {
        "required": [
          "reasonCode"
        ]
      }
    }
  ]
}
