{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/application-types/ProcurementMaterialExclusionReceipt/v1",
  "title": "ProcurementMaterialExclusionReceipt@1",
  "x-helix-ssotRefs": [
    "8.5.10"
  ],
  "x-helix-maxCanonicalBytes": 16384,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "intentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "excludedCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "scopeDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "intentId",
    "excludedCount",
    "scopeDigest"
  ]
}
