{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/application-types/LibraRunAdmissionDecision/v1",
  "title": "LibraRunAdmissionDecision@1",
  "x-helix-ssotRefs": [
    "8.6.21"
  ],
  "x-helix-maxCanonicalBytes": 8388608,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decisionId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "admissionKind": {
      "type": "string",
      "enum": [
        "initial",
        "replacement"
      ]
    },
    "subjectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "admissionRevision": {
      "type": "integer",
      "minimum": 1
    },
    "libraRunId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "replacementOfRunRef": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "libraRunId": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-f0-9]{64}$"
            },
            "stateRevision": {
              "type": "integer",
              "minimum": 1
            },
            "stateDigest": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-f0-9]{64}$"
            },
            "runScopeDigest": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-f0-9]{64}$"
            },
            "acceptanceSpecId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "executionBasisDigest": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "libraRunId",
            "stateRevision",
            "stateDigest",
            "runScopeDigest",
            "acceptanceSpecId",
            "executionBasisDigest"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "expectedRunAdmissionHead": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headState": {
          "type": "string",
          "enum": [
            "absent",
            "present"
          ]
        },
        "headRevision": {
          "type": "integer",
          "minimum": 0
        },
        "activeScopeSetDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "headState",
        "headRevision",
        "activeScopeSetDigest"
      ]
    },
    "runExecutionBasis": {
      "$ref": "helix://contracts/application-types/LibraRunExecutionBasis/v1"
    },
    "initialPriority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "priorityClass": {
          "type": "string",
          "enum": [
            "normal",
            "expedited"
          ]
        },
        "priorityIntentDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "priorityClass",
        "priorityIntentDigest"
      ]
    },
    "runScopeDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "decisionDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "decisionId",
    "admissionKind",
    "subjectId",
    "admissionRevision",
    "libraRunId",
    "expectedRunAdmissionHead",
    "runExecutionBasis",
    "initialPriority",
    "runScopeDigest",
    "decisionDigest"
  ]
}
