        "hintsDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "hintCount",
        "hintsDigest"
      ]
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "correctionId",
    "shelfEntryId",
    "admissionDigest",
    "canonicalIdentityDigest",
    "contentProfile",
    "identityKind",
    "javCode",
    "descriptiveFacts",
    "sourceFactDigest",
    "recordDigest",
    "sourceQualificationReference",
    "peopleHintsReference"
  ]
