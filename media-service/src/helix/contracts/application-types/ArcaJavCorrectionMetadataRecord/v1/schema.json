{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/application-types/ArcaJavCorrectionMetadataRecord/v1",
  "title": "ArcaJavCorrectionMetadataRecord@1",
  "x-helix-ssotRefs": [
    "3.5.5",
    "8.5.12",
    "8.6.19"
  ],
  "x-helix-maxCanonicalBytes": 65536,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/application-types/ArcaJavCorrectionMetadataRecord/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "correctionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shelfEntryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "admissionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "canonicalIdentityDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contentProfile": {
      "const": "jav"
    },
    "identityKind": {
      "const": "jav_code"
    },
    "javCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "descriptiveFacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              }
            },
            "required": [
              "key",
              "value"
            ]
          }
        }
      },
      "required": [
        "entries"
      ]
    },
    "sourceFactDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "recordDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceQualificationReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceVerifiedPayloadDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceSnapshotDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "siteRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "resourceKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "resourceUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "observationDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "sourceVerifiedPayloadDigest",
        "sourceSnapshotDigest",
        "sourceOrdinal",
        "siteRef",
        "resourceKey",
        "resourceUrl",
        "observationDigest"
      ]
