{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/application-types/ArcaDefectCommand/v1",
  "title": "ArcaDefectCommand@1",
  "x-helix-ssotRefs": [
    "5.6.7",
    "8.5.13",
    "8.6.21",
    "9.5.3",
    "9.5.4"
  ],
  "x-helix-maxCanonicalBytes": 65536,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "expectedInventoryRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expectedCareBasisDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expectedAuthorizationRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expectedCandidateDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "acknowledged": {
      "const": true
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "expectedInventoryRevision",
    "expectedCareBasisDigest",
    "expectedAuthorizationRevision",
    "expectedCandidateDigest",
    "acknowledged",
    "idempotencyKey"
  ]
}
