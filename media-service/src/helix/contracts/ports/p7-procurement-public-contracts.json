{
  "schemaVersion": 1,
  "contractId": "helix.ports.p7-procurement-public",
  "owner": "procurement",
  "ssotRefs": ["3.3", "8.1.4", "8.2.1", "9.7.1"],
  "facades": [
    {
      "exportName": "ProcurementCommandFacade",
      "packageId": "domains.procurement.public",
      "kind": "command-facade",
      "methods": [
        "registerMaterialField",
        "updateMaterialField",
        "publishExtractionPolicy",
        "requestFieldObservation",
        "retryFailedPreparation",
        "deregisterMaterialField"
      ]
    },
    {
      "exportName": "ProcurementQueryFacade",
      "packageId": "domains.procurement.public",
      "kind": "query-facade",
      "methods": [
        "listMaterialFields",
        "getMaterialField",
        "getExtractionPolicy",
        "getCandidatePackage"
      ]
    },
    {
      "exportName": "CandidateDeliveryPort",
      "packageId": "domains.procurement.public",
      "kind": "handoff-delivery-port",
      "methods": ["readSnapshot"],
      "inputSchemaRefs": {
        "readSnapshot": "helix://contracts/domain-types/CandidateDeliveryQuery/v1"
      },
      "outputSchemaRefs": {
        "readSnapshot": "helix://contracts/domain-types/CandidateDeliveryReadResult/v1"
      }
    },
    {
      "exportName": "ProcurementExecutionRegistration",
      "packageId": "domains.procurement.public",
      "kind": "foundation-construction-port",
      "methods": [
        "createCapabilityRegistration",
        "createProcessServices",
        "createPlanningRegistration"
      ]
    }
  ]
}
