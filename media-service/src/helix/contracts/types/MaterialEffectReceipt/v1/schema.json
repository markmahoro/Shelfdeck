{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/MaterialEffectReceipt/v1",
  "title": "MaterialEffectReceipt@1",
  "x-helix-ssotRefs": [
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/ReceiptEnvelope/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/MaterialEffectReceipt/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "receiptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "receiptKind": {
      "type": "string",
      "minLength": 1
    },
    "ownerDomain": {
      "type": "string",
      "minLength": 1
    },
    "scopeType": {
      "type": "string",
      "minLength": 1
    },
    "scopeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scopeDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "effectReceiptRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "committedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "targetBindingDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "materialEffectKind": {
      "type": "string",
      "minLength": 1
    },
    "effectReceiptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "finalRealityDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "finalMaterialIdentity": {
      "$ref": "helix://contracts/types/PhysicalMaterialIdentity/v2"
    },
    "targetEndpointId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "targetLocation": {
      "type": "string",
      "minLength": 1
    },
    "retiredMaterials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "identity": {
            "$ref": "helix://contracts/types/PhysicalMaterialIdentity/v2"
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "requiresSettlement": {
            "type": "boolean"
          }
        },
        "required": [
          "identity",
          "location",
          "requiresSettlement"
        ]
      },
      "maxItems": 1024
    },
    "supersededLocation": {
      "type": "string",
      "minLength": 1
    },
    "supersededMaterialIdentity": {
      "$ref": "helix://contracts/types/PhysicalMaterialIdentity/v2"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "receiptId",
    "receiptKind",
    "ownerDomain",
    "scopeType",
    "scopeId",
    "scopeDigest",
    "committedAtMs",
    "targetBindingDigest",
    "materialEffectKind",
    "effectReceiptId",
    "finalRealityDigest",
    "finalMaterialIdentity",
    "targetEndpointId",
    "targetLocation",
    "retiredMaterials"
  ]
}
