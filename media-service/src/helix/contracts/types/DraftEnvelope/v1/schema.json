{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/DraftEnvelope/v1",
  "title": "DraftEnvelope@1",
  "x-helix-ssotRefs": [
    "8.6.18"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "draftId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "draftKind": {
      "type": "string",
      "minLength": 1
    },
    "basisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "schemaRef": {
      "type": "string",
      "minLength": 1
    },
    "draftDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "producedAtMs": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "draftId",
    "draftKind",
    "basisDigest",
    "schemaRef",
    "draftDigest",
    "producedAtMs"
  ]
}
