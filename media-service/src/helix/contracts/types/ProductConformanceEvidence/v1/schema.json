{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/ProductConformanceEvidence/v1",
  "title": "ProductConformanceEvidence@1",
  "x-helix-ssotRefs": [
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/VerificationEnvelope/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/ProductConformanceEvidence/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "verificationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "verificationKind": {
      "type": "string",
      "minLength": 1
    },
    "basisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "result": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "not_applicable"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 1024
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 1024
    },
    "verifiedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "libraRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "acceptanceSpecId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "acceptanceSpecRecordDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "runExecutionBasisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "productSnapshotDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "productFactSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "evaluatedRequirementSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "unmetRequirementCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "identity_unmet",
          "season_identity_unmet",
          "structure_unmet",
          "episode_coverage_unmet",
          "metadata_field_unmet",
          "metadata_artifact_unmet",
          "sidecar_unrenderable",
          "image_undecodable",
          "media_form_unmet",
          "video_codec_unmet",
          "container_unmet",
          "file_extension_unmet",
          "minimum_raster_unmet",
          "system_upscale_forbidden",
          "primary_audio_unmet",
          "max_size_exceeded",
          "domain_binding_unmet",
          "checksum_unmet",
          "artifact_materialization_unmet",
          "layout_unmet"
        ]
      },
      "maxItems": 20
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "verificationId",
    "verificationKind",
    "basisDigest",
    "result",
    "reasonCodes",
    "evidenceRefs",
    "verifiedAtMs",
    "libraRunId",
    "acceptanceSpecId",
    "acceptanceSpecRecordDigest",
    "runExecutionBasisDigest",
    "productSnapshotDigest",
    "productFactSetDigest",
    "evaluatedRequirementSetDigest",
    "unmetRequirementCodes"
  ]
}
