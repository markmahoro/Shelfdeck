{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/LayoutEvidence/v1",
  "title": "LayoutEvidence@1",
  "x-helix-ssotRefs": [
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/EvidenceEnvelope/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/LayoutEvidence/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "evidenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evidenceKind": {
      "type": "string",
      "minLength": 1
    },
    "producerRef": {
      "type": "string",
      "minLength": 1
    },
    "basisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "payloadDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "observedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "sourceHandleDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "boundedScopeDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entryOrdinal": {
            "type": "integer",
            "minimum": 0
          },
          "entryKind": {
            "type": "string",
            "enum": [
              "file",
              "directory"
            ]
          },
          "relativeLocation": {
            "type": "string",
            "minLength": 1
          },
          "baseName": {
            "type": "string",
            "minLength": 1
          },
          "extension": {
            "type": "string",
            "minLength": 1
          },
          "identity": {
            "$ref": "helix://contracts/types/PhysicalMaterialIdentity/v2"
          },
          "endpointId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "mtimeNs": {
            "type": "string",
            "minLength": 1
          },
          "entryDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "entryOrdinal",
          "entryKind",
          "relativeLocation",
          "baseName",
          "endpointId",
          "location",
          "entryDigest"
        ]
      },
      "maxItems": 256
    },
    "entriesDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "layoutDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "evidenceId",
    "evidenceKind",
    "producerRef",
    "basisDigest",
    "payloadDigest",
    "observedAtMs",
    "sourceHandleDigest",
    "boundedScopeDigest",
    "entries",
    "entriesDigest",
    "layoutDigest"
  ]
}
