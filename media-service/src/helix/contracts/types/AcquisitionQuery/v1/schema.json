{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/AcquisitionQuery/v1",
  "title": "AcquisitionQuery@1",
  "x-helix-ssotRefs": [
    "6.4.7.1",
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/DraftEnvelope/v1",
  "x-helix-maxCanonicalBytes": 16384,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/AcquisitionQuery/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "draftId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "draftKind": {
      "type": "string",
      "minLength": 1
    },
    "basisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "draftDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "producedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "libraRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "runExecutionBasisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "resolvedIdentityDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "productStructureDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "structureKind": {
      "type": "string",
      "enum": [
        "single",
        "season"
      ]
    },
    "contentProfile": {
      "type": "string",
      "enum": [
        "movie",
        "series",
        "jav",
        "western_adult"
      ]
    },
    "providerIdentityAnchors": {
      "type": "array",
      "items": {
        "$ref": "helix://contracts/domain-types/ResolvedProviderIdentity/v1"
      },
      "maxItems": 16,
      "minItems": 1
    },
    "requestedEpisodeKeys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 256
    },
    "mediaRequirement": {
      "$ref": "helix://contracts/domain-types/MediaRequirement/v1"
    },
    "mediaRequirementDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "acquisitionPolicyDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "maxDownloadAttempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "queryTerms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "termKind": {
            "type": "string",
            "enum": [
              "provider_key",
              "title",
              "season"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "termDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "ordinal",
          "termKind",
          "value",
          "termDigest"
        ]
      },
      "maxItems": 32,
      "minItems": 1
    },
    "hardConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredStructureKind": {
          "type": "string",
          "enum": [
            "single",
            "season"
          ]
        },
        "requiredEpisodeKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 256
        },
        "mediaRequirementDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "requiredStructureKind",
        "requiredEpisodeKeys",
        "mediaRequirementDigest"
      ]
    },
    "queryDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "draftId",
    "draftKind",
    "basisDigest",
    "draftDigest",
    "producedAtMs",
    "libraRunId",
    "runExecutionBasisDigest",
    "resolvedIdentityDigest",
    "productStructureDigest",
    "structureKind",
    "contentProfile",
    "providerIdentityAnchors",
    "requestedEpisodeKeys",
    "mediaRequirement",
    "mediaRequirementDigest",
    "acquisitionPolicyDigest",
    "maxDownloadAttempts",
    "queryTerms",
    "hardConstraints",
    "queryDigest"
  ]
}
