{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/StableExternalMaterialEvidence/v1",
  "title": "StableExternalMaterialEvidence@1",
  "x-helix-ssotRefs": [
    "6.4.7.1",
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/VerificationEnvelope/v1",
  "x-helix-maxCanonicalBytes": 65536,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/StableExternalMaterialEvidence/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "verificationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "verificationKind": {
      "type": "string",
      "minLength": 1
    },
    "basisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "result": {
      "type": "string",
      "enum": [
        "passed"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 0
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 1024
    },
    "verifiedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "sourceExternalMaterialHandleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "stableExternalMaterialHandle": {
      "$ref": "helix://contracts/types/ExternalMaterialHandle/v1"
    },
    "observationWindow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startedAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "endedAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "quietWindowMs": {
          "type": "integer",
          "minimum": 1
        },
        "newestMutationAtMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "startedAtMs",
        "endedAtMs",
        "quietWindowMs",
        "newestMutationAtMs"
      ]
    },
    "stableDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "verificationId",
    "verificationKind",
    "basisDigest",
    "result",
    "reasonCodes",
    "evidenceRefs",
    "verifiedAtMs",
    "sourceExternalMaterialHandleId",
    "stableExternalMaterialHandle",
    "observationWindow",
    "stableDigest"
  ]
}
