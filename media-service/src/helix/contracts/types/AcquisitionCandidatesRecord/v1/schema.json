{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/AcquisitionCandidatesRecord/v1",
  "title": "AcquisitionCandidatesRecord@1",
  "x-helix-ssotRefs": [
    "6.4.7.1",
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/EvidenceEnvelope/v1",
  "x-helix-maxCanonicalBytes": 4096,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/AcquisitionCandidatesRecord/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "evidenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evidenceKind": {
      "type": "string",
      "minLength": 1
    },
    "producerRef": {
      "type": "string",
      "minLength": 1
    },
    "basisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "payloadDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "observedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "recordId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "libraRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "runExecutionBasisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "searchWorkId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "searchEventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "searchEventAttemptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "queryDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "integrationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "configRevision": {
      "type": "integer",
      "minimum": 1
    },
    "candidateCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "candidateSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "evidenceId",
    "evidenceKind",
    "producerRef",
    "basisDigest",
    "payloadDigest",
    "observedAtMs",
    "recordId",
    "libraRunId",
    "runExecutionBasisDigest",
    "searchWorkId",
    "searchEventId",
    "searchEventAttemptId",
    "queryDigest",
    "integrationId",
    "configRevision",
    "candidateCount",
    "candidateSetDigest"
  ]
}
