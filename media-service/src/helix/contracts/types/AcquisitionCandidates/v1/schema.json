{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/AcquisitionCandidates/v1",
  "title": "AcquisitionCandidates@1",
  "x-helix-ssotRefs": [
    "6.4.7.1",
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/EvidenceEnvelope/v1",
  "x-helix-maxCanonicalBytes": 65536,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/AcquisitionCandidates/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "evidenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evidenceKind": {
      "type": "string",
      "minLength": 1
    },
    "producerRef": {
      "type": "string",
      "minLength": 1
    },
    "basisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "payloadDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "observedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "queryDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "integrationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "configRevision": {
      "type": "integer",
      "minimum": 1
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "integrationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "configRevision": {
            "type": "integer",
            "minimum": 1
          },
          "providerCandidateRef": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "objectType": {
                "const": "acquisition_candidate"
              },
              "objectId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "digest": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "objectType",
              "objectId",
              "revision",
              "digest"
            ]
          },
          "providerRank": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "identityAnchors": {
            "type": "array",
            "items": {
              "$ref": "helix://contracts/domain-types/ResolvedProviderIdentity/v1"
            },
            "maxItems": 16
          },
          "structureKind": {
            "type": "string",
            "enum": [
              "single",
              "season"
            ]
          },
          "episodeKeys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 256
          },
          "availability": {
            "type": "string",
            "enum": [
              "available",
              "unavailable"
            ]
          },
          "advertisedMedia": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "resolution": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "status": {
                        "const": "known"
                      },
                      "value": {
                        "type": "string",
                        "enum": [
                          "4k",
                          "below_4k"
                        ]
                      },
                      "sourceField": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "status",
                      "value",
                      "sourceField"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "status": {
                        "const": "unknown"
                      },
                      "value": {
                        "type": "null"
                      },
                      "sourceField": {
                        "type": "null"
                      }
                    },
                    "required": [
                      "status",
                      "value",
                      "sourceField"
                    ]
                  }
                ]
              },
              "videoCodec": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "status": {
                        "const": "known"
                      },
                      "value": {
                        "type": "string",
                        "enum": [
                          "hevc",
                          "h264"
                        ]
                      },
                      "sourceField": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "status",
                      "value",
                      "sourceField"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "status": {
                        "const": "unknown"
                      },
                      "value": {
                        "type": "null"
                      },
                      "sourceField": {
                        "type": "null"
                      }
                    },
                    "required": [
                      "status",
                      "value",
                      "sourceField"
                    ]
                  }
                ]
              },
              "primaryAudioClasses": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "status": {
                        "const": "known"
                      },
                      "value": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "eac3_atmos",
                            "truehd",
                            "truehd_atmos",
                            "dts_hd_ma",
                            "dts_x"
                          ]
                        },
                        "maxItems": 5
                      },
                      "sourceField": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "status",
                      "value",
                      "sourceField"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "status": {
                        "const": "unknown"
                      },
                      "value": {
                        "type": "array",
                        "maxItems": 0
                      },
                      "sourceField": {
                        "type": "null"
                      }
                    },
                    "required": [
                      "status",
                      "value",
                      "sourceField"
                    ]
                  }
                ]
              },
              "sizeBytes": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "status": {
                        "const": "known"
                      },
                      "value": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "sourceField": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "status",
                      "value",
                      "sourceField"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "status": {
                        "const": "unknown"
                      },
                      "value": {
                        "type": "null"
                      },
                      "sourceField": {
                        "type": "null"
                      }
                    },
                    "required": [
                      "status",
                      "value",
                      "sourceField"
                    ]
                  }
                ]
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "provider": {
                    "const": "moviepilot"
                  },
                  "providerCandidateDigest": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "claimBasis": {
                    "type": "string",
                    "enum": [
                      "structured_and_release_fields",
                      "provider_row"
                    ]
                  }
                },
                "required": [
                  "provider",
                  "providerCandidateDigest",
                  "claimBasis"
                ]
              },
              "evidenceDigest": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "resolution",
              "videoCodec",
              "primaryAudioClasses",
              "sizeBytes",
              "source",
              "evidenceDigest"
            ]
          },
          "requirementAssessment": {
            "type": "string",
            "enum": [
              "compliant",
              "unknown",
              "noncompliant"
            ]
          },
          "assessmentReasonCodes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "video_codec_unknown",
                "video_codec_unmet",
                "resolution_unknown",
                "minimum_raster_unmet",
                "primary_audio_unknown",
                "primary_audio_unmet",
                "size_unknown",
                "max_size_exceeded"
              ]
            },
            "maxItems": 8
          },
          "candidateDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "candidateId",
          "integrationId",
          "configRevision",
          "providerCandidateRef",
          "providerRank",
          "identityAnchors",
          "structureKind",
          "episodeKeys",
          "availability",
          "advertisedMedia",
          "requirementAssessment",
          "assessmentReasonCodes",
          "candidateDigest"
        ]
      },
      "maxItems": 100
    },
    "candidateSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "evidenceId",
    "evidenceKind",
    "producerRef",
    "basisDigest",
    "payloadDigest",
    "observedAtMs",
    "queryDigest",
    "integrationId",
    "configRevision",
    "candidates",
    "candidateSetDigest"
  ]
}
