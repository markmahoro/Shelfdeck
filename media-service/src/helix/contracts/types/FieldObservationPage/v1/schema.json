    "fieldObservationWorkId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "observationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "fieldId": {
      "type": "string",
      "minLength": 1,
