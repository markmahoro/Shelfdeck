    "schemaVersion",
    "evidenceId",
    "evidenceKind",
    "producerRef",
    "basisDigest",
    "payloadDigest",
    "observedAtMs",
    "fieldObservationWorkId",
    "observationId",
    "fieldId",
    "accessRevision",
    "profileHintSnapshot",
    "pageOrdinal",
    "expectedObservationRevision",
