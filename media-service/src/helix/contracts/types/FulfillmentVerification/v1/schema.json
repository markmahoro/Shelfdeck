{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/FulfillmentVerification/v1",
  "title": "FulfillmentVerification@1",
  "x-helix-ssotRefs": [
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/VerificationEnvelope/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/FulfillmentVerification/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "verificationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "verificationKind": {
      "type": "string",
      "minLength": 1
    },
    "basisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "result": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "not_applicable"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 1024
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 1024
    },
    "verifiedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "finalInventoryDecisionDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "shelfStandardRevision": {
      "type": "integer",
      "minimum": 0
    },
    "finalRealityDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "memberEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceProductMaterialKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "verificationKind": {
            "type": "string",
            "enum": [
              "exact_package_identity",
              "readable_nfo"
            ]
          },
          "actualPhysicalIdentity": {
            "$ref": "helix://contracts/types/PhysicalMaterialIdentity/v2"
          },
          "observedAtMs": {
            "type": "integer",
            "minimum": 0
          },
          "semanticEvidenceDigest": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "sourceProductMaterialKey",
          "role",
          "verificationKind",
          "actualPhysicalIdentity",
          "observedAtMs",
          "semanticEvidenceDigest"
        ]
      },
      "maxItems": 4096
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "verificationId",
    "verificationKind",
    "basisDigest",
    "result",
    "reasonCodes",
    "evidenceRefs",
    "verifiedAtMs",
    "finalInventoryDecisionDigest",
    "shelfStandardRevision",
    "finalRealityDigest",
    "memberEvidence"
  ]
}
