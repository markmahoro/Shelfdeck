{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/LibraBindingDraft/v1",
  "title": "LibraBindingDraft@1",
  "x-helix-ssotRefs": [
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/DraftEnvelope/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/LibraBindingDraft/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "draftId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "draftKind": {
      "type": "string",
      "minLength": 1
    },
    "basisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "draftDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "producedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "subjectRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "resolutionKind": {
          "type": "string",
          "enum": [
            "new_subject",
            "season_extension"
          ]
        }
      },
      "required": [
        "subjectId",
        "resolutionKind"
      ]
    },
    "candidateDeliverySnapshotDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "materialKey": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "primary_payload",
              "structural_dependency"
            ]
          },
          "endpointId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "bindingRevision": {
            "const": 1
          },
          "locationEvidenceDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "episodeClaims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "episodeKey": {
                  "type": "string",
                  "minLength": 1
                },
                "seasonClaimDigest": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-f0-9]{64}$"
                },
                "claimDigest": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "episodeKey",
                "seasonClaimDigest",
                "claimDigest"
              ]
            },
            "maxItems": 32
          },
          "bindingDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "materialKey",
          "role",
          "endpointId",
          "location",
          "bindingRevision",
          "locationEvidenceDigest",
          "episodeClaims",
          "bindingDigest"
        ]
      },
      "maxItems": 1024
    },
    "bindingSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "draftId",
    "draftKind",
    "basisDigest",
    "draftDigest",
    "producedAtMs",
    "subjectRef",
    "candidateDeliverySnapshotDigest",
    "bindings",
    "bindingSetDigest"
  ]
}
