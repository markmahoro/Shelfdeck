{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/PersonPreferenceRevision/v1",
  "title": "PersonPreferenceRevision@1",
  "x-helix-ssotRefs": [
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/DomainFactEnvelope/v1",
