{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/CandidatePackage/v1",
  "title": "CandidatePackage@1",
  "x-helix-ssotRefs": [
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/ManifestEnvelope/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/CandidatePackage/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "manifestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "manifestKind": {
      "type": "string",
      "minLength": 1
    },
    "ownerDomain": {
      "type": "string",
      "minLength": 1
    },
    "memberCount": {
      "type": "integer",
      "minimum": 0
    },
    "membersDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifestDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "publishedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "candidatePackageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "packageRevision": {
      "type": "integer",
      "minimum": 1
    },
    "procurementRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "runBasisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "triageRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ruleRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "authorityDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "ruleRef",
        "revision",
        "authorityDigest"
      ]
    },
    "materialFieldContextRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fieldId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "accessRevision": {
          "type": "integer",
          "minimum": 1
        },
        "contextDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "fieldId",
        "accessRevision",
        "contextDigest"
      ]
    },
    "mediaType": {
      "type": "string",
      "enum": [
        "single",
        "group"
      ]
    },
    "contentProfile": {
      "type": "string",
      "enum": [
        "movie",
        "series",
        "jav",
        "western_adult"
      ]
    },
    "displayIdentity": {
      "type": "string",
      "minLength": 1
    },
    "identityMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claimedTitle": {
          "type": "string",
          "minLength": 1
        },
        "claimedYear": {
          "type": "integer",
          "minimum": 1
        },
        "seasonClaim": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "claimKind": {
              "type": "string",
              "enum": [
                "explicit_number",
                "provisional_group"
              ]
            },
            "seasonNumber": {
              "type": "integer",
              "minimum": 1
            },
            "provisionalGroupKey": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-f0-9]{64}$"
            },
            "claimDigest": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "claimKind",
            "claimDigest"
          ]
        },
        "javCode": {
          "type": "string",
          "minLength": 1
        },
        "contentProfileHint": {
          "type": "string",
          "enum": [
            "movie",
            "series",
            "jav",
            "western_adult",
            "mixed"
          ]
        },
        "sourceHints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "hintKind": {
                "type": "string",
                "enum": [
                  "field_content_profile_hint",
                  "filename_title",
                  "directory_title",
                  "filename_year",
                  "directory_year",
                  "filename_season",
                  "directory_season",
                  "filename_episode",
                  "jav_code",
                  "disc_structure",
                  "temporary_label"
                ]
              },
              "hintValue": {
                "type": "string",
                "minLength": 1
              },
              "evidenceDigest": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "hintKind",
              "hintValue",
              "evidenceDigest"
            ]
          },
          "maxItems": 256
        },
        "metadataDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "claimedTitle",
        "contentProfileHint",
        "sourceHints",
        "metadataDigest"
      ]
    },
    "identityClaim": {
      "$ref": "helix://contracts/types/IdentityClaim/v1"
    },
    "structureEvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "payloadDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "unitId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "unitDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "evidenceId",
        "payloadDigest",
        "unitId",
        "unitDigest"
      ]
    },
    "seasonContinuityClaims": {
      "type": "array",
      "items": {
        "$ref": "helix://contracts/types/SeasonContinuityClaim/v1"
      },
      "maxItems": 64
    },
    "seasonContinuityClaimSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "primaryInputManifestRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "manifestDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "memberCount": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "manifestId",
        "manifestDigest",
        "memberCount"
      ]
    },
    "relatedReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "referenceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "primaryMaterialKey": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "nfo",
              "poster",
              "fanart",
              "subtitle",
              "external_audio",
              "chapter",
              "sidecar"
            ]
          },
          "identity": {
            "$ref": "helix://contracts/types/PhysicalMaterialIdentity/v1"
          },
          "endpointId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "checksumAlgorithm": {
            "const": "sha256"
          },
          "checksumHex": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "associationEvidenceDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "referenceDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "referenceId",
          "primaryMaterialKey",
          "role",
          "identity",
          "endpointId",
          "location",
          "checksumAlgorithm",
          "checksumHex",
          "associationEvidenceDigest",
          "referenceDigest"
        ]
      },
      "maxItems": 1024
    },
    "relatedReferenceSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "memberControlEvidenceSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "packageDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "manifestId",
    "manifestKind",
    "ownerDomain",
    "memberCount",
    "membersDigest",
    "manifestDigest",
    "publishedAtMs",
    "candidatePackageId",
    "packageRevision",
    "procurementRunId",
    "runBasisDigest",
    "triageRule",
    "materialFieldContextRef",
    "mediaType",
    "contentProfile",
    "displayIdentity",
    "identityMetadata",
    "identityClaim",
    "structureEvidenceRef",
    "seasonContinuityClaims",
    "seasonContinuityClaimSetDigest",
    "primaryInputManifestRef",
    "relatedReferences",
    "relatedReferenceSetDigest",
    "memberControlEvidenceSetDigest",
    "packageDigest"
  ]
}
