{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/DomainFactEnvelope/v1",
  "title": "DomainFactEnvelope@1",
  "x-helix-ssotRefs": [
    "8.6.18"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "factId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ownerDomain": {
      "type": "string",
      "minLength": 1
    },
    "aggregateType": {
      "type": "string",
      "minLength": 1
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "factSchemaRef": {
      "type": "string",
      "minLength": 1
    },
    "factDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "commitMarker": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "committedAtMs": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "factId",
    "ownerDomain",
    "aggregateType",
    "aggregateId",
    "revision",
    "factSchemaRef",
    "factDigest",
    "commitMarker",
    "committedAtMs"
  ]
}
