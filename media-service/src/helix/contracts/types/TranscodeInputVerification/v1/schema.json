{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/TranscodeInputVerification/v1",
  "title": "TranscodeInputVerification@1",
  "x-helix-ssotRefs": [
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/VerificationEnvelope/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/TranscodeInputVerification/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "verificationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "verificationKind": {
      "type": "string",
      "minLength": 1
    },
    "basisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "result": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "not_applicable"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "source_handle_mismatch",
          "source_not_media",
          "probe_integrity_failure",
          "device_class_mismatch",
          "input_fence_mismatch",
          "source_dynamic_range_unsupported",
          "dolby_vision_base_layer_unsupported",
          "required_pipeline_profile_unavailable",
          "source_pixel_format_unsupported",
          "output_profile_unsupported",
          "encoder_rejected_source_pipeline",
          "rate_control_unsupported"
        ]
      },
      "maxItems": 13
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 1024
    },
    "verifiedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "sourceHandleDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "encodeIntentDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "probeEvidenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "probeEvidenceDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "deviceSnapshotDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "selectedDeviceClass": {
      "type": "string",
      "enum": [
        "software_cpu",
        "intel_qsv",
        "nvidia_nvenc",
        "amd_vaapi",
        "remote_worker"
      ]
    },
    "disposition": {
      "type": "string",
      "enum": [
        "compatible",
        "strategy_rejected",
        "integrity_rejected"
      ]
    },
    "rejectionScope": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "device_pipeline",
            "rate_control_strategy"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "coveredStrategyKeys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 16
    },
    "sampleCount": {
      "type": "integer",
      "minimum": 0
    },
    "passedSampleCount": {
      "type": "integer",
      "minimum": 0
    },
    "preflightDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "verificationId",
    "verificationKind",
    "basisDigest",
    "result",
    "reasonCodes",
    "evidenceRefs",
    "verifiedAtMs",
    "sourceHandleDigest",
    "encodeIntentDigest",
    "probeEvidenceId",
    "probeEvidenceDigest",
    "deviceId",
    "deviceSnapshotDigest",
    "selectedDeviceClass",
    "disposition",
    "rejectionScope",
    "coveredStrategyKeys",
    "sampleCount",
    "passedSampleCount",
    "preflightDigest"
  ]
}
