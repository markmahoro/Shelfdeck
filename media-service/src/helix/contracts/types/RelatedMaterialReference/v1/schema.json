{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/RelatedMaterialReference/v1",
  "title": "RelatedMaterialReference@1",
  "x-helix-ssotRefs": [
    "8.6.19"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "referenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "primaryMaterialKey": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "role": {
      "type": "string",
      "enum": [
        "nfo",
        "poster",
        "fanart",
        "subtitle",
        "external_audio",
        "chapter",
        "sidecar"
      ]
    },
    "identity": {
      "$ref": "helix://contracts/types/PhysicalMaterialIdentity/v2"
    },
    "endpointId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "fingerprintAlgorithm": {
      "const": "middle-256k-sha256"
    },
    "fingerprintVersion": {
      "const": 1
    },
    "contentFingerprint": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "associationKind": {
      "const": "exclusive"
    },
    "dispositionRequired": {
      "const": true
    },
    "associationEvidenceDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "dispositionBasisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "referenceDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "referenceId",
    "primaryMaterialKey",
    "role",
    "identity",
    "endpointId",
    "location",
    "fingerprintAlgorithm",
    "fingerprintVersion",
    "contentFingerprint",
    "associationKind",
    "dispositionRequired",
    "associationEvidenceDigest",
    "dispositionBasisDigest",
    "referenceDigest"
  ]
}
