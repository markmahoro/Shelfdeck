{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/PlayabilityEvidence/v1",
  "title": "PlayabilityEvidence@1",
  "x-helix-ssotRefs": [
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/EvidenceEnvelope/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/PlayabilityEvidence/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "evidenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evidenceKind": {
      "type": "string",
      "minLength": 1
    },
    "producerRef": {
      "type": "string",
      "minLength": 1
    },
    "basisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "payloadDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "observedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "materialResults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "materialKey": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "playable": {
            "type": "boolean"
          },
          "reasonCodes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 64
          }
        },
        "required": [
          "materialKey",
          "playable",
          "reasonCodes"
        ]
      },
      "maxItems": 1024
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "evidenceId",
    "evidenceKind",
    "producerRef",
    "basisDigest",
    "payloadDigest",
    "observedAtMs",
    "materialResults"
  ]
}
