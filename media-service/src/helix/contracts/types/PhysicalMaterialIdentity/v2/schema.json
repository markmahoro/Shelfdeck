{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/PhysicalMaterialIdentity/v2",
  "title": "PhysicalMaterialIdentity@2",
  "x-helix-ssotRefs": [
    "8.6.18"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/PhysicalMaterialIdentity/v2"
    },
    "schemaVersion": {
      "const": 2
    },
    "materialKey": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "mountScopeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "inode": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 0
    },
    "fingerprintAlgorithm": {
      "const": "middle-256k-sha256"
    },
    "fingerprintVersion": {
      "const": 1
    },
    "contentFingerprint": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "materialKey",
    "mountScopeId",
    "inode",
    "sizeBytes",
    "fingerprintAlgorithm",
    "fingerprintVersion",
    "contentFingerprint"
  ]
}
