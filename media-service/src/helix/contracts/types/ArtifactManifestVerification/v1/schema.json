{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/ArtifactManifestVerification/v1",
  "title": "ArtifactManifestVerification@1",
  "x-helix-ssotRefs": [
    "6.4.7.1",
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/VerificationEnvelope/v1",
  "x-helix-maxCanonicalBytes": 65536,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/ArtifactManifestVerification/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "verificationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "verificationKind": {
      "type": "string",
      "minLength": 1
    },
    "basisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "result": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "not_applicable"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 1024
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 1024
    },
    "verifiedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "manifestDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "contractRef": {
      "type": "string",
      "minLength": 1
    },
    "requirement": {
      "$ref": "helix://contracts/domain-types/ArtifactRequirement/v1"
    },
    "verifiedArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "artifactHandleId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "artifactKind": {
            "type": "string",
            "minLength": 1
          },
          "artifactRevision": {
            "type": "integer",
            "minimum": 1
          },
          "artifactDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "referenceDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "ordinal",
          "artifactHandleId",
          "artifactKind",
          "artifactRevision",
          "artifactDigest",
          "referenceDigest"
        ]
      },
      "maxItems": 64,
      "minItems": 1
    },
    "artifactDigests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-f0-9]{64}$"
      },
      "maxItems": 64,
      "minItems": 1
    },
    "verificationDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "verificationId",
    "verificationKind",
    "basisDigest",
    "result",
    "reasonCodes",
    "evidenceRefs",
    "verifiedAtMs",
    "manifestDigest",
    "contractRef",
    "requirement",
    "verifiedArtifacts",
    "artifactDigests",
    "verificationDigest"
  ]
}
