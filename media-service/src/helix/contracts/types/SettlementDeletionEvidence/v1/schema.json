{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/SettlementDeletionEvidence/v1",
  "title": "SettlementDeletionEvidence@1",
  "x-helix-ssotRefs": [
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/EvidenceEnvelope/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/SettlementDeletionEvidence/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "evidenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evidenceKind": {
      "type": "string",
      "minLength": 1
    },
    "producerRef": {
      "type": "string",
      "minLength": 1
    },
    "basisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "payloadDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "observedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "authorizationOrApprovalRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "materialKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "preDeleteIdentityDigest": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "postDeleteReality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaRef": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "recordKind": {
          "const": "post-delete-reality"
        },
        "recordDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "entries": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "not": {
                      "const": "final_targets"
                    }
                  },
                  "value": {
                    "type": [
                      "string",
                      "number",
                      "integer",
                      "boolean",
                      "null"
                    ]
                  }
                },
                "required": [
                  "key",
                  "value"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "const": "final_targets"
                  },
                  "value": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "materialKey": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "targetLocation": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096
                        },
                        "finalRealityDigest": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "materialKey",
                        "targetLocation",
                        "finalRealityDigest"
                      ]
                    },
                    "maxItems": 1024,
                    "minItems": 2,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "key",
                  "value"
                ]
              }
            ]
          },
          "maxItems": 256
        }
      },
      "required": [
        "schemaRef",
        "schemaVersion",
        "recordKind",
        "recordDigest",
        "entries"
      ]
    },
    "effectReceiptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "evidenceId",
    "evidenceKind",
    "producerRef",
    "basisDigest",
    "payloadDigest",
    "observedAtMs",
    "authorizationOrApprovalRef",
    "materialKey",
    "preDeleteIdentityDigest",
    "postDeleteReality",
    "effectReceiptId"
  ]
}
