{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/IntegrationHandle/v1",
  "title": "IntegrationHandle@1",
  "x-helix-ssotRefs": [
    "8.6.18"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/IntegrationHandle/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "handleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "integrationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "integrationType": {
      "type": "string",
      "minLength": 1
    },
    "configRevision": {
      "type": "integer",
      "minimum": 1
    },
    "secretRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "allowedOperation": {
      "type": "string",
      "minLength": 1
    },
    "expiresAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "fenceDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "siteRef": {
      "type": "string",
      "enum": [
        "javdb",
        "javmenu",
        "jav321",
        "fc2_official",
        "caribbeancom_official",
        "heydouga_official",
        "avwiki",
        "mgstage",
        "dl_getchu",
        "gyutto",
        "fanza"
      ]
    },
    "endpointProfileDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "networkRouteDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "authMode": {
      "type": "string",
      "enum": [
        "anonymous",
        "secret"
      ]
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "handleId",
    "integrationId",
    "integrationType",
    "configRevision",
    "secretRef",
    "allowedOperation",
    "expiresAtMs",
    "fenceDigest"
  ],
  "oneOf": [
    {
      "properties": {
        "integrationType": {
          "not": {
            "const": "jav_source"
          }
        },
        "secretRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "siteRef"
            ]
          },
          {
            "required": [
              "endpointProfileDigest"
            ]
          },
          {
            "required": [
              "networkRouteDigest"
            ]
          },
          {
            "required": [
              "authMode"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "integrationType": {
          "const": "jav_source"
        },
        "authMode": {
          "const": "anonymous"
        },
        "secretRef": {
          "type": "null"
        }
      },
      "required": [
        "siteRef",
        "endpointProfileDigest",
        "networkRouteDigest",
        "authMode"
      ]
    },
    {
      "properties": {
        "integrationType": {
          "const": "jav_source"
        },
        "authMode": {
          "const": "secret"
        },
        "secretRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "siteRef",
        "endpointProfileDigest",
        "networkRouteDigest",
        "authMode"
      ]
    }
  ]
}
