{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/PrimaryInputManifest/v1",
  "title": "PrimaryInputManifest@1",
  "x-helix-ssotRefs": [
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/ManifestEnvelope/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/PrimaryInputManifest/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "manifestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "manifestKind": {
      "type": "string",
      "minLength": 1
    },
    "ownerDomain": {
      "type": "string",
      "minLength": 1
    },
    "memberCount": {
      "type": "integer",
      "minimum": 0
    },
    "membersDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifestDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "publishedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "structureKind": {
      "type": "string",
      "enum": [
        "single",
        "season"
      ]
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "materialKey": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "primary_payload",
              "structural_dependency"
            ]
          },
          "physicalIdentity": {
            "$ref": "helix://contracts/types/PhysicalMaterialIdentity/v2"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "bindingRevision": {
            "type": "integer",
            "minimum": 1
          },
          "admittedControlRevision": {
            "type": "integer",
            "minimum": 1
          },
          "admittedControlProjectionDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "episodeClaims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "episodeKey": {
                  "type": "string",
                  "minLength": 1
                },
                "seasonClaimDigest": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-f0-9]{64}$"
                },
                "claimDigest": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "episodeKey",
                "seasonClaimDigest",
                "claimDigest"
              ]
            },
            "maxItems": 32
          },
          "memberDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "ordinal",
          "materialKey",
          "role",
          "physicalIdentity",
          "sizeBytes",
          "bindingRevision",
          "admittedControlRevision",
          "admittedControlProjectionDigest",
          "episodeClaims",
          "memberDigest"
        ]
      },
      "maxItems": 256,
      "minItems": 1
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "manifestId",
    "manifestKind",
    "ownerDomain",
    "memberCount",
    "membersDigest",
    "manifestDigest",
    "publishedAtMs",
    "structureKind",
    "members"
  ]
}
