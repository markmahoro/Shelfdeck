{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/PrimaryInputManifest/v1",
  "title": "PrimaryInputManifest@1",
  "x-helix-ssotRefs": [
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/ManifestEnvelope/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/PrimaryInputManifest/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "manifestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "manifestKind": {
      "type": "string",
      "minLength": 1
    },
    "ownerDomain": {
      "type": "string",
      "minLength": 1
    },
    "memberCount": {
      "type": "integer",
      "minimum": 0
    },
    "membersDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifestDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "publishedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "structureKind": {
      "type": "string",
      "enum": [
        "single",
        "season"
      ]
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "materialKey": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "episodeClaim": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "objectId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "schemaRef": {
                "type": "string",
                "minLength": 1
              },
              "snapshotDigest": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              },
              "objectKind": {
                "const": "episode-claim"
              }
            },
            "required": [
              "objectId",
              "revision",
              "schemaRef",
              "snapshotDigest",
              "objectKind"
            ]
          },
          "bindingRevision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "ordinal",
          "materialKey",
          "role",
          "bindingRevision"
        ]
      },
      "maxItems": 1024,
      "minItems": 1
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "manifestId",
    "manifestKind",
    "ownerDomain",
    "memberCount",
    "membersDigest",
    "manifestDigest",
    "publishedAtMs",
    "structureKind",
    "members"
  ]
}
