{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/IntakeMaterialVerification/v1",
  "title": "IntakeMaterialVerification@1",
  "x-helix-ssotRefs": [
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/VerificationEnvelope/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/IntakeMaterialVerification/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "verificationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "verificationKind": {
      "type": "string",
      "minLength": 1
    },
    "basisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "result": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "not_applicable"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 1024
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 1024
    },
    "verifiedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "candidatePackageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "packageDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidateDeliverySnapshotDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "verifiedMaterials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "materialKey": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "bindingRevision": {
            "type": "integer",
            "minimum": 1
          },
          "locationEvidenceDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "readHandleDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "verificationDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "materialKey",
          "bindingRevision",
          "locationEvidenceDigest",
          "readHandleDigest",
          "verificationDigest"
        ]
      },
      "maxItems": 1024
    },
    "verifiedMaterialSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "verificationId",
    "verificationKind",
    "basisDigest",
    "result",
    "reasonCodes",
    "evidenceRefs",
    "verifiedAtMs",
    "candidatePackageId",
    "packageDigest",
    "candidateDeliverySnapshotDigest",
    "verifiedMaterials",
    "verifiedMaterialSetDigest"
  ]
}
