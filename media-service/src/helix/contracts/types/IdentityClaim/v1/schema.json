{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/IdentityClaim/v1",
  "title": "IdentityClaim@1",
  "x-helix-ssotRefs": [
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/DraftEnvelope/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/IdentityClaim/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "draftId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "draftKind": {
      "type": "string",
      "minLength": 1
    },
    "basisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "draftDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "producedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "claimKind": {
      "type": "string",
      "enum": [
        "movie_title",
        "series_season",
        "jav_code",
        "western_temporary"
      ]
    },
    "mediaType": {
      "type": "string",
      "enum": [
        "single",
        "group"
      ]
    },
    "contentProfile": {
      "type": "string",
      "enum": [
        "movie",
        "series",
        "jav",
        "western_adult"
      ]
    },
    "claimedTitle": {
      "type": "string",
      "minLength": 1
    },
    "displayIdentity": {
      "type": "string",
      "minLength": 1
    },
    "claimedYear": {
      "type": "string",
      "minLength": 1
    },
    "seasonClaim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claimKind": {
          "type": "string",
          "enum": [
            "explicit_number",
            "provisional_group"
          ]
        },
        "seasonNumber": {
          "type": "integer",
          "minimum": 1
        },
        "provisionalGroupKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "claimDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "claimKind",
        "claimDigest"
      ]
    },
    "javCode": {
      "type": "string",
      "minLength": 1
    },
    "identityMetadataDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "structureUnitDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceHints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "hintKind": {
            "type": "string",
            "enum": [
              "field_content_profile_hint",
              "filename_title",
              "directory_title",
              "filename_year",
              "directory_year",
              "filename_season",
              "directory_season",
              "filename_episode",
              "jav_code",
              "disc_structure",
              "temporary_label"
            ]
          },
          "hintValue": {
            "type": "string",
            "minLength": 1
          },
          "evidenceDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "hintKind",
          "hintValue",
          "evidenceDigest"
        ]
      },
      "maxItems": 256
    },
    "claimDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "draftId",
    "draftKind",
    "basisDigest",
    "draftDigest",
    "producedAtMs",
    "claimKind",
    "mediaType",
    "contentProfile",
    "claimedTitle",
    "displayIdentity",
    "identityMetadataDigest",
    "structureUnitDigest",
    "sourceHints",
    "claimDigest"
  ]
}
