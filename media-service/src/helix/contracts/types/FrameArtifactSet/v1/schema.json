{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/FrameArtifactSet/v1",
  "title": "FrameArtifactSet@1",
  "x-helix-ssotRefs": [
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/ManifestEnvelope/v1",
  "x-helix-maxCanonicalBytes": 16384,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/FrameArtifactSet/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "manifestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "manifestKind": {
      "const": "western_frame_artifact_set"
    },
    "ownerDomain": {
      "const": "libra"
    },
    "memberCount": {
      "const": 1
    },
    "membersDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifestDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "publishedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "libraRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sourceMaterialDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "samplingPlanDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "outputTargetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "frameCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "frameMemberSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "frameSetArtifactHandle": {
      "$ref": "helix://contracts/types/ArtifactHandle/v1"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "manifestId",
    "manifestKind",
    "ownerDomain",
    "memberCount",
    "membersDigest",
    "manifestDigest",
    "publishedAtMs",
    "libraRunId",
    "workspaceId",
    "sourceMaterialDigest",
    "samplingPlanDigest",
    "outputTargetDigest",
    "frameCount",
    "frameMemberSetDigest",
    "frameSetArtifactHandle"
  ]
}
