{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/FieldAccessHandle/v1",
  "title": "FieldAccessHandle@1",
  "x-helix-ssotRefs": [
    "8.6.18"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/FieldAccessHandle/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "handleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "fieldId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "accessRevision": {
      "type": "integer",
      "minimum": 1
    },
    "accessDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "endpointId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "rootLocation": {
      "type": "string",
      "minLength": 1
    },
    "mountScopeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "mountScopeRevision": {
      "type": "integer",
      "minimum": 1
    },
    "allowedOperations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "read",
          "list",
          "stat",
          "fingerprint"
        ]
      },
      "maxItems": 4
    },
    "containmentDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "expiresAtMs": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "handleId",
    "fieldId",
    "accessRevision",
    "accessDigest",
    "endpointId",
    "rootLocation",
    "mountScopeId",
    "mountScopeRevision",
    "allowedOperations",
    "containmentDigest",
    "expiresAtMs"
  ]
}
