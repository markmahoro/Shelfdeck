{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/ProductMediaVerification/v1",
  "title": "ProductMediaVerification@1",
  "x-helix-ssotRefs": [
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/VerificationEnvelope/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/ProductMediaVerification/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "verificationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "verificationKind": {
      "type": "string",
      "minLength": 1
    },
    "basisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "result": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "not_applicable"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "output_handle_mismatch",
          "output_not_media",
          "media_form_unmet",
          "video_codec_unmet",
          "container_unmet",
          "file_extension_unmet",
          "minimum_raster_unmet",
          "system_upscale_forbidden",
          "primary_audio_unmet",
          "max_size_exceeded",
          "requirement_integrity_failure",
          "dynamic_range_conversion_unmet",
          "output_color_profile_unmet",
          "dolby_vision_metadata_not_removed",
          "playback_decode_failed"
        ]
      },
      "maxItems": 15
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 1024
    },
    "verifiedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "candidateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "candidateNodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "candidateBasisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidateKind": {
      "type": "string",
      "enum": [
        "direct_input",
        "workspace_output"
      ]
    },
    "libraRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "producingEventId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "productMaterialHandleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "productMaterialHandleDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "productMaterialFenceDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "workspaceMediaHandleId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "mediaRequirementId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "mediaRequirementDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceProbeEvidenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sourceProbeEvidenceDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "outputProbeEvidenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "outputProbeEvidenceDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "qualitySummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "videoCodec": {
          "type": "string",
          "minLength": 1
        },
        "container": {
          "type": "string",
          "minLength": 1
        },
        "fileExtension": {
          "type": "string",
          "minLength": 1
        },
        "displayRasterClass": {
          "type": "string",
          "minLength": 1
        },
        "primaryAudioClasses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 128
        },
        "sourceDisplayRasterClass": {
          "type": "string",
          "minLength": 1
        },
        "systemUpscaleDetected": {
          "type": "boolean"
        }
      },
      "required": [
        "videoCodec",
        "container",
        "fileExtension",
        "displayRasterClass",
        "primaryAudioClasses",
        "sourceDisplayRasterClass",
        "systemUpscaleDetected"
      ]
    },
    "spaceSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": {
          "type": "string",
          "enum": [
            "product",
            "episode"
          ]
        },
        "actualSizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maxSizeBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "withinLimit": {
          "type": "boolean"
        }
      },
      "required": [
        "unit",
        "actualSizeBytes",
        "maxSizeBytes",
        "withinLimit"
      ]
    },
    "dynamicRangeSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceDynamicRangeKind": {
          "type": "string",
          "enum": [
            "sdr",
            "hdr10_compatible",
            "hlg",
            "dolby_vision",
            "unknown"
          ]
        },
        "outputDynamicRangeKind": {
          "type": "string",
          "enum": [
            "sdr",
            "hdr10_compatible",
            "hlg",
            "dolby_vision",
            "unknown"
          ]
        },
        "conversionOperation": {
          "type": "string",
          "enum": [
            "none",
            "preserve",
            "tone_map_to_sdr_bt709"
          ]
        },
        "outputPixelFormat": {
          "type": "string",
          "minLength": 1
        },
        "outputColorProfile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "range": {
              "type": "string",
              "minLength": 1
            },
            "primaries": {
              "type": "string",
              "minLength": 1
            },
            "transfer": {
              "type": "string",
              "minLength": 1
            },
            "matrix": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "range",
            "primaries",
            "transfer",
            "matrix"
          ]
        },
        "dolbyVisionMetadataPresent": {
          "type": "boolean"
        }
      },
      "required": [
        "sourceDynamicRangeKind",
        "outputDynamicRangeKind",
        "conversionOperation",
        "outputPixelFormat",
        "outputColorProfile",
        "dolbyVisionMetadataPresent"
      ]
    },
    "decodeSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "samplePointsPercent": {
          "type": "array",
          "items": {
            "enum": [
              5,
              50,
              95
            ]
          },
          "maxItems": 3,
          "uniqueItems": true
        },
        "passedSamplePointsPercent": {
          "type": "array",
          "items": {
            "enum": [
              5,
              50,
              95
            ]
          },
          "maxItems": 3,
          "uniqueItems": true
        },
        "decodeDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "samplePointsPercent",
        "passedSamplePointsPercent",
        "decodeDigest"
      ]
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "verificationId",
    "verificationKind",
    "basisDigest",
    "result",
    "reasonCodes",
    "evidenceRefs",
    "verifiedAtMs",
    "candidateId",
    "candidateNodeId",
    "candidateBasisDigest",
    "candidateKind",
    "libraRunId",
    "producingEventId",
    "productMaterialHandleId",
    "productMaterialHandleDigest",
    "productMaterialFenceDigest",
    "workspaceMediaHandleId",
    "mediaRequirementId",
    "mediaRequirementDigest",
    "sourceProbeEvidenceId",
    "sourceProbeEvidenceDigest",
    "outputProbeEvidenceId",
    "outputProbeEvidenceDigest",
    "qualitySummary",
    "spaceSummary",
    "dynamicRangeSummary",
    "decodeSummary"
  ]
}
