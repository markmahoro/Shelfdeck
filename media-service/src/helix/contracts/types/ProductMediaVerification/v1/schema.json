{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/ProductMediaVerification/v1",
  "title": "ProductMediaVerification@1",
  "x-helix-ssotRefs": [
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/VerificationEnvelope/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/ProductMediaVerification/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "verificationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "verificationKind": {
      "type": "string",
      "minLength": 1
    },
    "basisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "result": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "not_applicable"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 1024
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 1024
    },
    "verifiedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "candidateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "candidateNodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "candidateBasisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidateKind": {
      "type": "string",
      "enum": [
        "direct_input",
        "workspace_output"
      ]
    },
    "libraRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "producingEventId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "productMaterialHandleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "productMaterialHandleDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "productMaterialFenceDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "workspaceMediaHandleId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "mediaRequirementId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "mediaRequirementDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceProbeEvidenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sourceProbeEvidenceDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "outputProbeEvidenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "outputProbeEvidenceDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "qualitySummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "videoCodec": {
          "type": "string",
          "minLength": 1
        },
        "container": {
          "type": "string",
          "minLength": 1
        },
        "fileExtension": {
          "type": "string",
          "minLength": 1
        },
        "displayRasterClass": {
          "type": "string",
          "minLength": 1
        },
        "primaryAudioClasses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 128
        },
        "sourceDisplayRasterClass": {
          "type": "string",
          "minLength": 1
        },
        "systemUpscaleDetected": {
          "type": "boolean"
        }
      },
      "required": [
        "videoCodec",
        "container",
        "fileExtension",
        "displayRasterClass",
        "primaryAudioClasses",
        "sourceDisplayRasterClass",
        "systemUpscaleDetected"
      ]
    },
    "spaceSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": {
          "type": "string",
          "enum": [
            "product",
            "episode"
          ]
        },
        "actualSizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "maxSizeBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "withinLimit": {
          "type": "boolean"
        }
      },
      "required": [
        "unit",
        "actualSizeBytes",
        "maxSizeBytes",
        "withinLimit"
      ]
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "verificationId",
    "verificationKind",
    "basisDigest",
    "result",
    "reasonCodes",
    "evidenceRefs",
    "verifiedAtMs",
    "candidateId",
    "candidateNodeId",
    "candidateBasisDigest",
    "candidateKind",
    "libraRunId",
    "producingEventId",
    "productMaterialHandleId",
    "productMaterialHandleDigest",
    "productMaterialFenceDigest",
    "workspaceMediaHandleId",
    "mediaRequirementId",
    "mediaRequirementDigest",
    "sourceProbeEvidenceId",
    "sourceProbeEvidenceDigest",
    "outputProbeEvidenceId",
    "outputProbeEvidenceDigest",
    "qualitySummary",
    "spaceSummary"
  ]
}
