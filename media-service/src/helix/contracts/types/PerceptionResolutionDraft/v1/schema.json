{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/PerceptionResolutionDraft/v1",
  "title": "PerceptionResolutionDraft@1",
  "x-helix-ssotRefs": [
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/DraftEnvelope/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/PerceptionResolutionDraft/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "draftId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "draftKind": {
      "type": "string",
      "minLength": 1
    },
    "basisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "draftDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "producedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "queryContract": {
      "type": "string",
      "minLength": 1
    },
    "queryInputDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "resultKind": {
      "type": "string",
      "enum": [
        "found",
        "not_found"
      ]
    },
    "winningPerceptionId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "ruleRevision": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "draftId",
    "draftKind",
    "basisDigest",
    "draftDigest",
    "producedAtMs",
    "queryContract",
    "queryInputDigest",
    "resultKind",
    "ruleRevision"
  ]
}
