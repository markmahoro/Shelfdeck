{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/PerceptionResolutionDraft/v1",
  "title": "PerceptionResolutionDraft@1",
  "x-helix-ssotRefs": [
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/DraftEnvelope/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/PerceptionResolutionDraft/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "draftId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "draftKind": {
      "type": "string",
      "minLength": 1
    },
    "basisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "draftDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "producedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "queryContract": {
      "type": "string",
      "minLength": 1
    },
    "querySchemaRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "queryInputDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "factKind": {
      "type": "string",
      "enum": [
        "rating",
        "watched"
      ]
    },
    "recordSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "ruleRevision": {
      "type": "integer",
      "minimum": 1
    },
    "ruleDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "resultKind": {
      "type": "string",
      "enum": [
        "found",
        "not_found"
      ]
    },
    "winningPerceptionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "resolvedValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "factKind": {
              "const": "rating"
            },
            "value": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          },
          "required": [
            "factKind",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "factKind": {
              "const": "watched"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "factKind",
            "value"
          ]
        }
      ]
    },
    "resolvedProvenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "winningPerceptionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sourceKind": {
          "type": "string",
          "minLength": 1
        },
        "sourceRecordKey": {
          "type": "string",
          "minLength": 1
        },
        "sourceRecordRevision": {
          "type": "integer",
          "minimum": 1
        },
        "provenanceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "provenanceDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "matchedAnchorEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "anchorKind": {
                "type": "string",
                "minLength": 1
              },
              "strengthRank": {
                "type": "integer",
                "minimum": 1
              },
              "evidenceDigest": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "anchorKind",
              "strengthRank",
              "evidenceDigest"
            ]
          },
          "maxItems": 16
        }
      },
      "required": [
        "winningPerceptionId",
        "sourceKind",
        "sourceRecordKey",
        "sourceRecordRevision",
        "provenanceRef",
        "provenanceDigest",
        "matchedAnchorEvidence"
      ]
    },
    "reasonCode": {
      "type": "string",
      "enum": [
        "no_matching_record",
        "requested_fact_absent",
        "strongest_value_conflict"
      ]
    },
    "duplicateRelationDrafts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourcePerceptionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "targetPerceptionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "ruleRevision": {
            "type": "integer",
            "minimum": 1
          },
          "evidenceDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "sourcePerceptionId",
          "targetPerceptionId",
          "ruleRevision",
          "evidenceDigest"
        ]
      },
      "maxItems": 1024
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "draftId",
    "draftKind",
    "basisDigest",
    "draftDigest",
    "producedAtMs",
    "queryContract",
    "querySchemaRef",
    "queryInputDigest",
    "factKind",
    "recordSetDigest",
    "ruleRevision",
    "ruleDigest",
    "resultKind",
    "duplicateRelationDrafts"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "resultKind": {
            "const": "found"
          }
        },
        "required": [
          "resultKind"
        ]
      },
      "then": {
        "required": [
          "winningPerceptionId",
          "resolvedValue",
          "resolvedProvenance"
        ],
        "not": {
          "required": [
            "reasonCode"
          ]
        }
      },
      "else": {
        "required": [
          "reasonCode"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "winningPerceptionId"
              ]
            },
            {
              "required": [
                "resolvedValue"
              ]
            },
            {
              "required": [
                "resolvedProvenance"
              ]
            }
          ]
        }
      }
    }
  ]
}
