{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/MediaProbeEvidence/v1",
  "title": "MediaProbeEvidence@1",
  "x-helix-ssotRefs": [
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/EvidenceEnvelope/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/MediaProbeEvidence/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "evidenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evidenceKind": {
      "type": "string",
      "minLength": 1
    },
    "producerRef": {
      "type": "string",
      "minLength": 1
    },
    "basisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "payloadDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "observedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "sourceHandleDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "resultKind": {
      "type": "string",
      "enum": [
        "probed",
        "not_media"
      ]
    },
    "reasonCode": {
      "type": "string",
      "enum": [
        "probe_not_media"
      ]
    },
    "container": {
      "type": "string",
      "minLength": 1
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 0
    },
    "videoStreams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "streamIndex": {
            "type": "integer",
            "minimum": 0
          },
          "dispositionDefault": {
            "type": "boolean"
          },
          "codec": {
            "type": "string",
            "minLength": 1
          },
          "codedWidth": {
            "type": "integer",
            "minimum": 1
          },
          "codedHeight": {
            "type": "integer",
            "minimum": 1
          },
          "sampleAspectRatio": {
            "type": "string",
            "minLength": 1
          },
          "rotation": {
            "type": "integer",
            "minimum": -359,
            "maximum": 359
          },
          "displayWidth": {
            "type": "integer",
            "minimum": 1
          },
          "displayHeight": {
            "type": "integer",
            "minimum": 1
          },
          "longEdge": {
            "type": "integer",
            "minimum": 1
          },
          "shortEdge": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "streamIndex",
          "dispositionDefault",
          "codec",
          "codedWidth",
          "codedHeight",
          "sampleAspectRatio",
          "rotation",
          "displayWidth",
          "displayHeight",
          "longEdge",
          "shortEdge"
        ]
      },
      "maxItems": 64
    },
    "audioStreams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "streamIndex": {
            "type": "integer",
            "minimum": 0
          },
          "dispositionDefault": {
            "type": "boolean"
          },
          "codec": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "channels": {
            "type": "integer",
            "minimum": 1
          },
          "channelLayout": {
            "type": "string",
            "minLength": 1
          },
          "formatTags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 64
          },
          "normalizedAudioClass": {
            "type": "string",
            "enum": [
              "eac3_atmos",
              "truehd",
              "truehd_atmos",
              "dts_hd_ma",
              "dts_x",
              "other"
            ]
          },
          "language": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "streamIndex",
          "dispositionDefault",
          "codec",
          "profile",
          "channels",
          "channelLayout",
          "formatTags",
          "normalizedAudioClass"
        ]
      },
      "maxItems": 128
    },
    "subtitleStreams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "streamIndex": {
            "type": "integer",
            "minimum": 0
          },
          "codec": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "streamIndex",
          "codec"
        ]
      },
      "maxItems": 256
    },
    "discTopology": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "discKind": {
          "type": "string",
          "enum": [
            "bdmv",
            "dvd",
            "iso"
          ]
        },
        "titleCount": {
          "type": "integer",
          "minimum": 1
        },
        "singleTitleEvidenceDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "topologyVersion": {
          "type": "integer",
          "minimum": 1
        },
        "topologyDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "titleSelectionEvidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "selectionRule": {
              "const": "unique_payload_bytes_then_duration_then_distinct_clip_count_then_playlist_path"
            },
            "candidateTitleCount": {
              "type": "integer",
              "minimum": 1
            },
            "selectedPlaylist": {
              "type": "string",
              "minLength": 1
            },
            "candidateDigests": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "signature": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "playlist": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueStreamBytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "durationMs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "distinctClipCount": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "signature",
                  "playlist",
                  "uniqueStreamBytes",
                  "durationMs",
                  "distinctClipCount"
                ]
              },
              "maxItems": 256,
              "minItems": 1
            }
          },
          "required": [
            "selectionRule",
            "candidateTitleCount",
            "selectedPlaylist",
            "candidateDigests"
          ]
        },
        "selectedPlaylist": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "relativeLocation": {
              "type": "string",
              "minLength": 1
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0
            },
            "clipIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 256,
              "minItems": 1
            }
          },
          "required": [
            "relativeLocation",
            "durationMs",
            "clipIds"
          ]
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "relativeLocation": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "enum": [
                  "primary_payload",
                  "structural_dependency"
                ]
              },
              "clipId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "relativeLocation",
              "role"
            ]
          },
          "maxItems": 256,
          "minItems": 1
        }
      },
      "required": [
        "discKind",
        "titleCount",
        "singleTitleEvidenceDigest",
        "topologyVersion",
        "topologyDigest",
        "titleSelectionEvidence",
        "selectedPlaylist",
        "members"
      ]
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "evidenceId",
    "evidenceKind",
    "producerRef",
    "basisDigest",
    "payloadDigest",
    "observedAtMs",
    "sourceHandleDigest",
    "resultKind",
    "sizeBytes",
    "videoStreams",
    "audioStreams",
    "subtitleStreams"
  ]
}
