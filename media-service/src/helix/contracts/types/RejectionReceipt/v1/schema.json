{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/RejectionReceipt/v1",
  "title": "RejectionReceipt@1",
  "x-helix-ssotRefs": [
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/ReceiptEnvelope/v1",
  "x-helix-maxCanonicalBytes": 16384,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/RejectionReceipt/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "receiptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "receiptKind": {
      "const": "handoff_b_rejected"
    },
    "ownerDomain": {
      "const": "arca"
    },
    "scopeType": {
      "const": "acceptance_decision"
    },
    "scopeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scopeDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "effectReceiptRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "committedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "acceptanceDecisionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "handoffKind": {
      "const": "libra_to_arca"
    },
    "offerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "deliverableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "rejectionCode": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceEvidenceSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "rejectionDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "receiptDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "receiptId",
    "receiptKind",
    "ownerDomain",
    "scopeType",
    "scopeId",
    "scopeDigest",
    "committedAtMs",
    "acceptanceDecisionId",
    "handoffKind",
    "offerId",
    "deliverableId",
    "rejectionCode",
    "acceptanceEvidenceSetDigest",
    "rejectionDigest",
    "receiptDigest"
  ]
}
