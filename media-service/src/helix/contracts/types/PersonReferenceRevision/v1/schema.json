{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/PersonReferenceRevision/v1",
  "title": "PersonReferenceRevision@1",
  "x-helix-ssotRefs": [
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/DomainFactEnvelope/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/PersonReferenceRevision/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "factId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ownerDomain": {
      "type": "string",
      "minLength": 1
    },
    "aggregateType": {
      "type": "string",
      "minLength": 1
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "factSchemaRef": {
      "type": "string",
      "minLength": 1
    },
    "factDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "commitMarker": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "committedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "personId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "referenceRevision": {
      "type": "integer",
      "minimum": 1
    },
    "operationKind": {
      "type": "string",
      "enum": [
        "add_image",
        "release_image"
      ]
    },
    "affectedReferenceAssetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "affectedReferenceFaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "activeReferenceAssets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "referenceAssetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "artifactHandleId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "artifactDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "referenceAssetId",
          "artifactHandleId",
          "artifactDigest"
        ]
      },
      "maxItems": 1024
    },
    "activeReferenceFaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "referenceFaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "referenceAssetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "embeddingHandleId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "embeddingDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "modelRef": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "referenceFaceId",
          "referenceAssetId",
          "embeddingHandleId",
          "embeddingDigest",
          "modelRef"
        ]
      },
      "maxItems": 1024
    },
    "activeAssetSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "activeFaceSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "referenceSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "factId",
    "ownerDomain",
    "aggregateType",
    "aggregateId",
    "revision",
    "factSchemaRef",
    "factDigest",
    "commitMarker",
    "committedAtMs",
    "personId",
    "referenceRevision",
    "operationKind",
    "affectedReferenceAssetId",
    "affectedReferenceFaceId",
    "activeReferenceAssets",
    "activeReferenceFaces",
    "activeAssetSetDigest",
    "activeFaceSetDigest",
    "referenceSetDigest"
  ]
}
