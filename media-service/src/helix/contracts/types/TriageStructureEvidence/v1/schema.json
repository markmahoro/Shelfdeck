{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/TriageStructureEvidence/v1",
  "title": "TriageStructureEvidence@1",
  "x-helix-ssotRefs": [
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/EvidenceEnvelope/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/TriageStructureEvidence/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "evidenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evidenceKind": {
      "type": "string",
      "minLength": 1
    },
    "producerRef": {
      "type": "string",
      "minLength": 1
    },
    "basisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "payloadDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "observedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "procurementRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "runBasisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "selectionDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "triageRuleAuthorityDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "materialFieldContextDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "pageRequestDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "pageOrdinal": {
      "type": "integer",
      "minimum": 0
    },
    "cursorIn": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "cursorOut": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "resultKind": {
      "type": "string",
      "enum": [
        "resolved",
        "not_ready"
      ]
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "unitId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "mediaType": {
            "type": "string",
            "enum": [
              "single",
              "group"
            ]
          },
          "contentProfile": {
            "type": "string",
            "enum": [
              "movie",
              "series",
              "jav",
              "western_adult"
            ]
          },
          "structureKind": {
            "type": "string",
            "enum": [
              "single",
              "season"
            ]
          },
          "displayIdentity": {
            "type": "string",
            "minLength": 1
          },
          "identityMetadata": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "claimedTitle": {
                "type": "string",
                "minLength": 1
              },
              "claimedYear": {
                "type": "integer",
                "minimum": 1
              },
              "seasonClaim": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "claimKind": {
                    "type": "string",
                    "enum": [
                      "explicit_number",
                      "provisional_group"
                    ]
                  },
                  "seasonNumber": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "provisionalGroupKey": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "claimDigest": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "claimKind",
                  "claimDigest"
                ]
              },
              "javCode": {
                "type": "string",
                "minLength": 1
              },
              "contentProfileHint": {
                "type": "string",
                "enum": [
                  "movie",
                  "series",
                  "jav",
                  "western_adult",
                  "mixed"
                ]
              },
              "sourceHints": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "hintKind": {
                      "type": "string",
                      "enum": [
                        "field_content_profile_hint",
                        "filename_title",
                        "directory_title",
                        "filename_year",
                        "directory_year",
                        "filename_season",
                        "directory_season",
                        "filename_episode",
                        "jav_code",
                        "disc_structure",
                        "temporary_label"
                      ]
                    },
                    "hintValue": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidenceDigest": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "hintKind",
                    "hintValue",
                    "evidenceDigest"
                  ]
                },
                "maxItems": 256
              },
              "metadataDigest": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "claimedTitle",
              "contentProfileHint",
              "sourceHints",
              "metadataDigest"
            ]
          },
          "seasonContinuityClaims": {
            "type": "array",
            "items": {
              "$ref": "helix://contracts/types/SeasonContinuityClaim/v1"
            },
            "maxItems": 64
          },
          "seasonContinuityClaimSetDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "materialKey": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-f0-9]{64}$"
                },
                "bindingRevision": {
                  "type": "integer",
                  "minimum": 1
                },
                "admittedControlRevision": {
                  "type": "integer",
                  "minimum": 1
                },
                "admittedControlProjectionDigest": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-f0-9]{64}$"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "primary_payload",
                    "structural_dependency"
                  ]
                },
                "episodeClaims": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "episodeKey": {
                        "type": "string",
                        "minLength": 1
                      },
                      "seasonClaimDigest": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "claimDigest": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "episodeKey",
                      "seasonClaimDigest",
                      "claimDigest"
                    ]
                  },
                  "maxItems": 32
                },
                "memberClaimDigest": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "materialKey",
                "bindingRevision",
                "admittedControlRevision",
                "admittedControlProjectionDigest",
                "role",
                "episodeClaims",
                "memberClaimDigest"
              ]
            },
            "maxItems": 256,
            "minItems": 1
          },
          "relatedReferences": {
            "type": "array",
            "items": {
              "$ref": "helix://contracts/types/RelatedMaterialReference/v1"
            },
            "maxItems": 1024
          },
          "unitDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "unitId",
          "mediaType",
          "contentProfile",
          "structureKind",
          "displayIdentity",
          "identityMetadata",
          "seasonContinuityClaims",
          "seasonContinuityClaimSetDigest",
          "members",
          "relatedReferences",
          "unitDigest"
        ]
      },
      "maxItems": 100
    },
    "unassignedMaterials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "materialKey": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "reasonCode": {
            "type": "string",
            "enum": [
              "probe_not_media",
              "no_video_stream",
              "non_positive_duration",
              "content_profile_unresolved",
              "conflicting_season_claim",
              "episode_claim_unresolved",
              "disc_structure_incomplete",
              "disc_multi_title_unsupported",
              "triage_unit_contract_too_large",
              "structure_ambiguous"
            ]
          },
          "evidenceDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "materialKey",
          "reasonCode",
          "evidenceDigest"
        ]
      },
      "maxItems": 256
    },
    "unitSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "unassignedSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "evidenceId",
    "evidenceKind",
    "producerRef",
    "basisDigest",
    "payloadDigest",
    "observedAtMs",
    "procurementRunId",
    "runBasisDigest",
    "selectionDigest",
    "triageRuleAuthorityDigest",
    "materialFieldContextDigest",
    "pageRequestDigest",
    "pageOrdinal",
    "cursorIn",
    "cursorOut",
    "resultKind",
    "units",
    "unassignedMaterials",
    "unitSetDigest",
    "unassignedSetDigest"
  ]
}
