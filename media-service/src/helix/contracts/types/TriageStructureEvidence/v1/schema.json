{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/TriageStructureEvidence/v1",
  "title": "TriageStructureEvidence@1",
  "x-helix-ssotRefs": [
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/EvidenceEnvelope/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/TriageStructureEvidence/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "evidenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "evidenceKind": {
      "type": "string",
      "minLength": 1
    },
    "producerRef": {
      "type": "string",
      "minLength": 1
    },
    "basisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "payloadDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "observedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "structureKind": {
      "type": "string",
      "enum": [
        "single",
        "season"
      ]
    },
    "primaryRoles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 1024
    },
    "episodeClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "episodeKey": {
            "type": "string",
            "minLength": 1
          },
          "materialKey": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "claimDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "episodeKey",
          "materialKey",
          "claimDigest"
        ]
      },
      "maxItems": 1024
    },
    "relatedReferences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 1024
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "evidenceId",
    "evidenceKind",
    "producerRef",
    "basisDigest",
    "payloadDigest",
    "observedAtMs",
    "structureKind",
    "primaryRoles",
    "episodeClaims",
    "relatedReferences"
  ]
}
