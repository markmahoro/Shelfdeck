{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/EffectReceipt/v1",
  "title": "EffectReceipt@1",
  "x-helix-ssotRefs": [
    "8.6.18"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/EffectReceipt/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "effectReceiptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "effectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "effectClass": {
      "type": "string",
      "enum": [
        "workspace_write",
        "external_request",
        "domain_fact_commit",
        "responsibility_control_commit",
        "material_commit",
        "destructive_commit"
      ]
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "commitMarker": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "externalReceiptRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "outputDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "verificationEvidenceDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "committedAtMs": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "effectReceiptId",
    "effectId",
    "effectClass",
    "idempotencyKey",
    "commitMarker",
    "outputDigest",
    "verificationEvidenceDigest",
    "committedAtMs"
  ]
}
