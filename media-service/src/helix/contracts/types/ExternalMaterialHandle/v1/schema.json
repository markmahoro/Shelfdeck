    "accessFenceDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "handleId",
    "integrationId",
    "externalObjectRef",
    "endpointId",
    "location",
    "structureKind",
    "manifestDigest",
    "observationRevision",
    "accessFenceDigest"
