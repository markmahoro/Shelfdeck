{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/ExternalMaterialHandle/v1",
  "title": "ExternalMaterialHandle@1",
  "x-helix-ssotRefs": [
    "8.6.18"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/ExternalMaterialHandle/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "handleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "integrationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "configRevision": {
      "type": "integer",
      "minimum": 1
    },
    "externalObjectRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "endpointId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "landingBinding": {
      "$ref": "helix://contracts/types/MoviePilotLandingBinding/v1"
    },
    "structureKind": {
      "type": "string",
      "enum": [
        "single",
        "season"
      ]
    },
    "outputSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "integrationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "configRevision": {
          "type": "integer",
          "minimum": 1
        },
        "externalObjectRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "endpointId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "landingBinding": {
          "$ref": "helix://contracts/types/MoviePilotLandingBinding/v1"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "structureKind": {
          "type": "string",
          "enum": [
            "single",
            "season"
          ]
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ordinal": {
                "type": "integer",
                "minimum": 0
              },
              "externalMemberId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "relativePath": {
                "type": "string",
                "minLength": 1
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 0
              },
              "checksumAlgorithm": {
                "const": "sha256"
              },
              "checksumHex": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              },
              "episodeClaims": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "episodeKey": {
                      "type": "string",
                      "minLength": 1
                    },
                    "claimDigest": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "episodeKey",
                    "claimDigest"
                  ]
                },
                "maxItems": 32
              },
              "memberDigest": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "ordinal",
              "externalMemberId",
              "relativePath",
              "sizeBytes",
              "checksumAlgorithm",
              "checksumHex",
              "episodeClaims",
              "memberDigest"
            ]
          },
          "maxItems": 256,
          "minItems": 1
        },
        "identityAnchors": {
          "type": "array",
          "items": {
            "$ref": "helix://contracts/domain-types/ResolvedProviderIdentity/v1"
          },
          "maxItems": 16
        },
        "observedTitle": {
          "type": "string",
          "minLength": 1
        },
        "releaseYear": {
          "type": "integer",
          "minimum": 1
        },
        "observedAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "newestMutationAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "memberSetDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "manifestDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshotDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "integrationId",
        "configRevision",
        "externalObjectRef",
        "endpointId",
        "landingBinding",
        "location",
        "structureKind",
        "members",
        "identityAnchors",
        "observedAtMs",
        "newestMutationAtMs",
        "memberSetDigest",
        "manifestDigest",
        "snapshotDigest"
      ]
    },
    "manifestDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "observationRevision": {
      "type": "integer",
      "minimum": 1
    },
    "accessFenceDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "handleId",
    "integrationId",
    "configRevision",
    "externalObjectRef",
    "endpointId",
    "location",
    "landingBinding",
    "structureKind",
    "outputSnapshot",
    "manifestDigest",
    "observationRevision",
    "accessFenceDigest"
  ]
}
