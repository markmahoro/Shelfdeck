{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/ProductMetadataDraft/v1",
  "title": "ProductMetadataDraft@1",
  "x-helix-ssotRefs": [
    "6.4.7.1",
    "8.6.19"
  ],
  "x-helix-envelopeRef": "helix://contracts/types/DraftEnvelope/v1",
  "x-helix-maxCanonicalBytes": 65536,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/ProductMetadataDraft/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "draftId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "draftKind": {
      "type": "string",
      "minLength": 1
    },
    "basisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "draftDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "producedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "resolvedIdentityDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceBasisKind": {
      "type": "string",
      "enum": [
        "metadata_observation",
        "western_analysis"
      ]
    },
    "metadataObservationSetDigest": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "westernAnalysisVariantDigest": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "fieldProvenance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fieldPath": {
            "type": "string",
            "minLength": 1
          },
          "sourceKind": {
            "type": "string",
            "enum": [
              "related_nfo",
              "provider",
              "western_analysis"
            ]
          },
          "sourceRef": {
            "type": "string",
            "minLength": 1
          },
          "evidenceDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "fieldPath",
          "sourceKind",
          "sourceRef",
          "evidenceDigest"
        ]
      },
      "maxItems": 1024
    },
    "descriptiveFacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaRef": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "recordKind": {
          "const": "descriptive-facts"
        },
        "recordDigest": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "integer",
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "key",
              "value"
            ]
          },
          "maxItems": 256
        }
      },
      "required": [
        "schemaRef",
        "schemaVersion",
        "recordKind",
        "recordDigest",
        "entries"
      ]
    },
    "providerIdentities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "objectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "schemaRef": {
            "type": "string",
            "minLength": 1
          },
          "snapshotDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "objectKind": {
            "const": "provider-identity"
          }
        },
        "required": [
          "objectId",
          "revision",
          "schemaRef",
          "snapshotDigest",
          "objectKind"
        ]
      },
      "maxItems": 128
    },
    "mediaCastDraftRef": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "artifactRequirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "objectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "schemaRef": {
            "type": "string",
            "minLength": 1
          },
          "snapshotDigest": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "objectKind": {
            "const": "artifact-requirement"
          }
        },
        "required": [
          "objectId",
          "revision",
          "schemaRef",
          "snapshotDigest",
          "objectKind"
        ]
      },
      "maxItems": 256
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "draftId",
    "draftKind",
    "basisDigest",
    "draftDigest",
    "producedAtMs",
    "resolvedIdentityDigest",
    "sourceBasisKind",
    "metadataObservationSetDigest",
    "westernAnalysisVariantDigest",
    "fieldProvenance",
    "descriptiveFacts",
    "providerIdentities",
    "mediaCastDraftRef",
    "artifactRequirements"
  ]
}
