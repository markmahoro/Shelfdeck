{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/FaceEmbeddingSetHandle/v1",
  "title": "FaceEmbeddingSetHandle@1",
  "x-helix-ssotRefs": [
    "8.6.18"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/FaceEmbeddingSetHandle/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "artifactHandleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "artifactHandle": {
      "$ref": "helix://contracts/types/ArtifactHandle/v1"
    },
    "computationMode": {
      "type": "string",
      "enum": [
        "western_frame_set",
        "single_reference_face"
      ]
    },
    "libraRunId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "workspaceId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "faceModelRefDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceArtifactSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "detectedFaceCount": {
      "type": "integer",
      "minimum": 0
    },
    "vectorCount": {
      "type": "integer",
      "minimum": 0
    },
    "dimension": {
      "type": "integer",
      "minimum": 1
    },
    "embeddingDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "handleDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "artifactHandleId",
    "artifactHandle",
    "computationMode",
    "libraRunId",
    "workspaceId",
    "faceModelRefDigest",
    "sourceArtifactSetDigest",
    "detectedFaceCount",
    "vectorCount",
    "dimension",
    "embeddingDigest",
    "handleDigest"
  ]
}
