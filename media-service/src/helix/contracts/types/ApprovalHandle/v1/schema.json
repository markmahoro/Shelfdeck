{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/types/ApprovalHandle/v1",
  "title": "ApprovalHandle@1",
  "x-helix-ssotRefs": [
    "8.6.18"
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaRef": {
      "const": "helix://contracts/types/ApprovalHandle/v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "approvalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ownerDomain": {
      "type": "string",
      "minLength": 1
    },
    "processType": {
      "type": "string",
      "minLength": 1
    },
    "processId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "exactEffectScopeDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "approvalRevision": {
      "type": "integer",
      "minimum": 1
    },
    "actorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "invalidatingFactDigests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-f0-9]{64}$"
      },
      "maxItems": 1024
    },
    "approvedAtMs": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schemaRef",
    "schemaVersion",
    "approvalId",
    "ownerDomain",
    "processType",
    "processId",
    "eventId",
    "exactEffectScopeDigest",
    "approvalRevision",
    "actorId",
    "invalidatingFactDigests",
    "approvedAtMs"
  ]
}
