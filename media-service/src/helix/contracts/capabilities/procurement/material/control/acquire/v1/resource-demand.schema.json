{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/capabilities/procurement.material.control.acquire/v1/resource-demand",
  "title": "procurement.material.control.acquire@1 resource demand",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "resourceKinds": {
      "type": "array",
      "prefixItems": [
        {
          "const": "disk_io"
        },
        {
          "const": "network"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "demandDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "resourceKinds",
    "demandDigest"
  ]
}
