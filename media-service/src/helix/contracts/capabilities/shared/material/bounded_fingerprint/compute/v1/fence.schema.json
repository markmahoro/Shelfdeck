{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/capabilities/shared.material.bounded_fingerprint.compute/v1/fence",
  "title": "shared.material.bounded_fingerprint.compute@1 fence",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "basisDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "inputSetDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "eventFenceDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "effectScopeDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "basisDigest",
    "inputSetDigest"
  ]
}
