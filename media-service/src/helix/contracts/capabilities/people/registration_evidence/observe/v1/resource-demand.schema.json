{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/capabilities/people.registration_evidence.observe/v1/resource-demand",
  "title": "people.registration_evidence.observe@1 resource demand",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "resourceKinds": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "network"
            }
          ],
          "minItems": 1,
          "maxItems": 1
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "cpu"
            }
          ],
          "minItems": 1,
          "maxItems": 1
        }
      ]
    },
    "demandDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "resourceKinds",
    "demandDigest"
  ]
}
