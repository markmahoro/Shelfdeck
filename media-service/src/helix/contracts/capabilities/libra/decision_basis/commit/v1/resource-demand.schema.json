{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/capabilities/libra.decision_basis.commit/v1/resource-demand",
  "title": "libra.decision_basis.commit@1 resource demand",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "resourceKinds": {
      "type": "array",
      "prefixItems": [
        {
          "const": "cpu"
        }
      ],
      "minItems": 1,
      "maxItems": 1
    },
    "demandDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "resourceKinds",
    "demandDigest"
  ]
}
