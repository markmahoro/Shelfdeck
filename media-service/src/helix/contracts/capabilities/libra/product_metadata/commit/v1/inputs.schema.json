{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/capabilities/libra.product_metadata.commit/v1/inputs",
  "title": "libra.product_metadata.commit@1 named inputs",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "libraProductMetadataSourceBasisMetadataObservationOrWesternAnalysis": {
      "$ref": "#/$defs/libraProductMetadataSourceBasisMetadataObservationOrWesternAnalysis"
    },
    "productMetadataDraft": {
      "$ref": "#/$defs/productMetadataDraft"
    },
    "verifiedArtifactManifest": {
      "$ref": "#/$defs/verifiedArtifactManifest"
    },
    "mediaCastFactRefProductFactIdFactRevisionFactDigest": {
      "$ref": "#/$defs/mediaCastFactRefProductFactIdFactRevisionFactDigest"
    },
    "domainFactCommitHandle": {
      "$ref": "#/$defs/domainFactCommitHandle"
    }
  },
  "required": [
    "libraProductMetadataSourceBasisMetadataObservationOrWesternAnalysis",
    "productMetadataDraft",
    "verifiedArtifactManifest",
    "mediaCastFactRefProductFactIdFactRevisionFactDigest",
    "domainFactCommitHandle"
  ],
  "$defs": {
    "libraProductMetadataSourceBasisMetadataObservationOrWesternAnalysis": {
      "$ref": "helix://contracts/domain-types/LibraProductMetadataSourceBasisMetadataObservationWesternAnalysis/v1",
      "x-helix-typeExpression": "LibraProductMetadataSourceBasis(metadata_observation|western_analysis)"
    },
    "productMetadataDraft": {
      "$ref": "helix://contracts/types/ProductMetadataDraft/v1",
      "x-helix-typeExpression": "ProductMetadataDraft"
    },
    "verifiedArtifactManifest": {
      "$ref": "helix://contracts/domain-types/VerifiedArtifactManifest/v1",
      "x-helix-typeExpression": "VerifiedArtifactManifest"
    },
    "mediaCastFactRefProductFactIdFactRevisionFactDigest": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "productFactId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "factRevision": {
              "type": "integer",
              "minimum": 1
            },
            "factDigest": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "productFactId",
            "factRevision",
            "factDigest"
          ]
        },
        {
          "type": "null"
        }
      ],
      "x-helix-typeExpression": "mediaCastFactRef?{productFactId,factRevision,factDigest}"
    },
    "domainFactCommitHandle": {
      "$ref": "helix://contracts/types/DomainFactCommitHandle/v1",
      "x-helix-typeExpression": "DomainFactCommitHandle"
    }
  }
}
