{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helix://contracts/capabilities/arca.aftercare.media.transcode/v1/resource-demand",
  "title": "arca.aftercare.media.transcode@1 resource demand",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "resourceKinds": {
      "type": "array",
      "prefixItems": [
        {
          "const": "compute_device"
        },
        {
          "const": "cpu"
        },
        {
          "const": "disk_io"
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "demandDigest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "resourceKinds",
    "demandDigest"
  ]
}
