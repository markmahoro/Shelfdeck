    "semanticRules": [
      "`PK(cleanup_scope_id,material_handle_id)`",
      "`rowMutability=cas_lifecycle`且只允许expected `pending→completed|blocked`",
      "每项都保存完整available Control Projection revision/digest，uncontrolled的owner列全NULL，两个owned variant全非NULL且分别要求ownerDomain=libra或非libra",
      "pending的committed/effect/evidence/receipt列全NULL",
      "terminal Evidence typed JSON≤`16 KiB`，completed固定`WorkspaceMaterialDeletionEvidence@1`，blocked固定`WorkspaceCleanupBlockingEvidence@1`",
      "libra_owned的released Control revision严格为expected+1并由historical Control row重建Receipt，other_owned不得主动删除或释放Control、只允许already-absent Evidence，blocked不得释放Reference或Control。Scope revision history由每个member唯一`committed_scope_state_revision`排序，与初始revision 1确定性重建，禁止later current row覆盖历史",
      "`INDEX(state,updated_at_ms)`"
    ],
    "rawContract": {
      "columns": "`cleanup_scope_id FK, material_handle_id, material_key, workspace_reference_id, expected_reference_revision, expected_reference_digest, control_disposition(uncontrolled|libra_owned|other_owned), expected_control_revision, expected_control_projection_digest, expected_control_owner_domain NULL, expected_control_owner_scope_type NULL, expected_control_owner_scope_id NULL, cleanup_kind(delete_or_verify_absent), state(pending|completed|blocked), state_revision, state_digest, committed_scope_state_revision NULL, deletion_effect_id NULL, outcome_evidence_schema_ref NULL, outcome_evidence_id NULL, outcome_evidence_json NULL, outcome_evidence_digest NULL, cleanup_receipt_id NULL, updated_at_ms`",
      "constraints": "`PK(cleanup_scope_id,material_handle_id)`；`rowMutability=cas_lifecycle`且只允许expected `pending→completed|blocked`；每项都保存完整available Control Projection revision/digest，uncontrolled的owner列全NULL，两个owned variant全非NULL且分别要求ownerDomain=libra或非libra；pending的committed/effect/evidence/receipt列全NULL；terminal Evidence typed JSON≤`16 KiB`，completed固定`WorkspaceMaterialDeletionEvidence@1`，blocked固定`WorkspaceCleanupBlockingEvidence@1`；libra_owned的released Control revision严格为expected+1并由historical Control row重建Receipt，other_owned不得主动删除或释放Control、只允许already-absent Evidence，blocked不得释放Reference或Control。Scope revision history由每个member唯一`committed_scope_state_revision`排序，与初始revision 1确定性重建，禁止later current row覆盖历史；`INDEX(state,updated_at_ms)`"
    },
