    "rawContract": {
      "columns": "`claim_id PK, actor_id, idempotency_key, request_digest, source_id, active_source_id NULL UNIQUE, state(preparing_person|confirming_source|completed|conflict|person_failed), revision INTEGER, payload_schema_ref, payload_json, payload_digest, person_schema_ref NULL, person_json NULL, person_digest NULL, receipt_schema_ref NULL, receipt_json NULL, receipt_digest NULL, last_failure_code NULL, created_at_ms, updated_at_ms`",
