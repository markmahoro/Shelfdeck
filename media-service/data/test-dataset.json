            { "method": "PATCH", "path": "/v1/admin/transcode/config", "body": {
              "transcodeReplaceConfirmRequired": true,
              "transcodeEncodingDevices": "<nvenc_only.patch.transcodeEncodingDevices>",
              "transcodeCpuParticipationStrategy": "normal",
              "transcodeMaxCpuSlots": 1
            }, "note": "模拟用户在管理页面勾选 nvenc:0 入池 + 开启替换确认" }
