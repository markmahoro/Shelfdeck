  "adminWebUiVerification": {
    "description": "管理页面 UI 正确性验证 — 对比 API 返回字段与 UI 实际展示字段，发现缺失/错误",
    "sourceFile": "media-service/web/src/pages/TranscodeConfigPage.tsx",
    "apiEndpoint": "GET /v1/admin/transcode/config (app.js:390)",
    "apiReturns": [
      "transcodeTempRoot",
      "transcodeReplaceConfirmRequired",
      "ffmpegPath",
      "ffprobePath",
      "transcodeEncodingDevices",
      "transcodeMaxCpuSlots",
      "transcodeCpuParticipationStrategy"
    ],
    "uiDisplays": [
      "transcodeTempRoot",
      "transcodeReplaceConfirmRequired",
      "ffmpegPath",
      "ffprobePath",
      "transcodeCpuParticipationStrategy"
    ],
    "knownGaps": [
      {
        "id": "GAP-01",
        "severity": "high",
        "field": "transcodeEncodingDevices",
        "issue": "API 返回但 TS 类型 (TranscodeConfig) 不包含，UI 不读取/不渲染。管理页面无法将探测到的设备加入编码池——探测结果只读展示，无「入池」按钮，无法写入 transcodeEncodingDevices。",
        "impact": "编码资源池永远为空 → 所有转码任务 precheck 失败 (No encode devices in pool)。这是当前卡住转码功能的核心问题。",
        "verifyBy": "GET /v1/admin/transcode/config → 检查 transcodeEncodingDevices 是否为空数组；打开管理页面 /transcode → 确认检测设备后无入池操作入口"
      },
      {
        "id": "GAP-02",
        "severity": "medium",
        "field": "transcodeMaxCpuSlots",
        "issue": "API 返回且 TS 类型包含、但 UI 未绑定。init 时未从 API 响应初始化 form state，页面无输入控件，savePool 的 PATCH payload 不包含此字段。",
        "impact": "用户无法调整 CPU 并发槽数，只能使用默认值 1。多 CPU 核心场景受限。",
        "verifyBy": "查看管理页面「其他设置」区域 → 确认无 CPU 槽数输入；PATCH /v1/admin/transcode/config 携带 transcodeMaxCpuSlots → 确认值被持久化但不展示"
      },
      {
        "id": "GAP-03",
        "severity": "high",
        "field": "设备池保存按钮语义错误",
        "issue": "「保存设备池」按钮 (savePool mutation) 实际只 PATCH transcodeReplaceConfirmRequired + transcodeCpuParticipationStrategy，不保存设备池本身。按钮位置在「编码设备池」section 之后的「其他设置」section，名称和功能不匹配。",
        "impact": "用户点击「保存设备池」期望保存编码设备配置，实际只保存了替换确认开关和 CPU 策略。设备池仍然无法配置。",
        "verifyBy": "打开管理页面 → 点击「保存设备池」→ 检查 PATCH 请求 body → 确认不包含 transcodeEncodingDevices"
      },
      {
        "id": "GAP-04",
        "severity": "low",
        "field": "transcodeEncodingDevices (TS 类型)",
        "issue": "TranscodeConfig 接口 (types/index.ts:51-58) 缺少 transcodeEncodingDevices 字段定义。API 返回 7 个字段，类型只定义 6 个。",
        "impact": "TypeScript 编译期无法检测到缺失，调用方访问该字段无类型提示。",
        "verifyBy": "查看 types/index.ts TranscodeConfig → 确认字段列表不包含 transcodeEncodingDevices"
      }
    ],
    "testRounds": [
      {
        "round": "UI-1",
        "description": "验证 admin API 字段完整性",
        "steps": [
          { "method": "GET", "path": "/v1/admin/transcode/config", "check": "响应包含 7 个字段: transcodeTempRoot, transcodeReplaceConfirmRequired, ffmpegPath, ffprobePath, transcodeEncodingDevices, transcodeMaxCpuSlots, transcodeCpuParticipationStrategy" },
          { "method": "GET", "path": "/v1/admin/transcode/device-pool", "check": "devices 数组每项包含 stableKey, inPool, priority, maxSlots, encoder, status, activeSlots" },
          { "method": "GET", "path": "/v1/admin/transcode/probe-devices", "check": "devices 数组每项包含 stableKey, label, backend, gpuIndex" }
        ]
      },
      {
        "round": "UI-2",
        "description": "验证 transcodeMaxCpuSlots 可读写但 UI 不展示",
        "steps": [
          { "method": "PATCH", "path": "/v1/admin/transcode/config", "body": { "transcodeMaxCpuSlots": 4 }, "note": "直接 PATCH 写入（绕开 UI 限制）" },
          { "method": "GET", "path": "/v1/admin/transcode/config", "check": "transcodeMaxCpuSlots === 4，确认后端支持但 UI 不展示" },
          { "method": "PATCH", "path": "/v1/admin/transcode/config", "body": { "transcodeMaxCpuSlots": 1 }, "note": "恢复默认" }
        ]
      },
      {
        "round": "UI-3",
        "description": "验证 transcodeEncodingDevices 可写入（绕开 UI）并影响设备池",
        "steps": [
