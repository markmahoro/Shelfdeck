        },
        "taskOps": [
          { "method": "POST", "path": "/v1/tasks", "body": { "itemId": "80128", "actionType": "transcode" }, "expect": { "status": 201 } },
          { "method": "POST", "path": "/v1/tasks", "body": { "itemId": "96433", "actionType": "transcode" }, "expect": { "status": 201 } },
          { "method": "GET",  "path": "/v1/tasks", "note": "轮询，等待任务进入 awaiting_user_confirm", "expect": { "status": "awaiting_user_confirm" } },
