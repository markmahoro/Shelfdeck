{
  "name": "shelfdeck-media-service",
  "version": "1.0.0",
  "private": true,
  "description": "ShelfDeck media management service (REST)",
  "license": "GPL-3.0",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "test:helix-architecture": "node scripts/helix-architecture-verify.js",
    "test:helix-persistence": "node scripts/helix-p3-persistence-verify.js",
    "test:helix-persistence-exit": "node scripts/helix-p3-exit-audit.js --require-clean",
    "test:helix-runtime": "node scripts/helix-p4-runtime-verify.js",
    "test:helix-runtime-exit": "node scripts/helix-p4-exit-audit.js --require-clean",
    "test:helix-platform": "node scripts/helix-p5-integration-verify.js",
    "test:helix-platform-exit": "node scripts/helix-p5-exit-audit.js --require-clean",
    "test:helix-horizontal": "node scripts/helix-p6-horizontal-verify.js",
    "test:helix-horizontal-exit": "node scripts/helix-p6-exit-audit.js --require-clean",
    "test:helix-procurement": "node scripts/helix-p7-procurement-verify.js",
    "test:helix-procurement-exit": "node scripts/helix-p7-exit-audit.js --require-clean",
    "test:helix-libra-front-half": "node scripts/helix-p8-libra-front-half-verify.js",
    "test:helix-libra-front-half-exit": "node scripts/helix-p8-exit-audit.js --require-clean",
    "test:helix-routing-real": "node scripts/helix-real-routing-e2e.js",
    "build:web": "cd web && npm run build",
    "helix:clean-init": "node scripts/helix-clean-init.js",
    "test:helix-p14-docker-entrypoint": "node scripts/p14-beta-impl-02-docker-retest.js",
    "test:helix-p14-product-surface-matrix": "node scripts/p14-product-surface-matrix-check.js",
    "dist:win": "node scripts/package-win.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^9.3.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.0.0",
    "chokidar": "^4.0.3",
    "fastify": "^5.10.0",
    "ffmpeg-static": "^5.2.0",
    "sharp": "^0.35.2",
    "undici": "^6.27.0"
  },
  "optionalDependencies": {
    "systray2": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
