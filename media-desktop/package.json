{
  "name": "shelfdeck-media-desktop",
  "version": "1.0.0",
  "description": "ShelfDeck desktop client (Windows)",
  "main": "electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "cross-env NODE_ENV=development CONTROL_PLANE_URL=http://127.0.0.1:18080 electron .",
    "dev:media-service": "cd ../media-service && npm start",
    "dev:clean-url": "node -e \"try { require('fs').unlinkSync(require('path').join(process.cwd(), '.vite-dev-server-url')); } catch (_) {}\"",
    "dev": "npm run dev:clean-url && concurrently -k \"npm run dev:renderer\" \"wait-on file:.vite-dev-server-url && node scripts/run-electron-dev.js\"",
    "build": "cross-env NODE_ENV=production vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "cross-env NODE_ENV=production CONTROL_PLANE_URL=http://127.0.0.1:18080 electron .",
    "dist:win": "npm run build && electron-builder --win portable"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "electron-store": "^8.2.0",
    "ffmpeg-static": "^5.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.shelfdeck.media.desktop",
    "productName": "ShelfDeck",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/@ffprobe-installer/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/@ffprobe-installer/**"
    ],
    "forceCodeSigning": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    }
  }
}
